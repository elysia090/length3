{
  "name": "length3",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && pnpm run check:tests",
    "check:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check . && prettier --check \"src/**/*.astro\"",
    "format": "biome format --write . && prettier --write \"src/**/*.astro\"",
    "test:unit": "vitest run",
    "test:e2e": "env -u NO_COLOR FORCE_COLOR=0 playwright test --config=playwright.config.ts --project=chromium",
    "test": "pnpm run check && pnpm run test:unit && pnpm run test:e2e",
    "bench": "node ./scripts/bench/run.ts",
    "screenshots": "env -u NO_COLOR FORCE_COLOR=0 playwright test --config=playwright.config.ts --project=screenshots",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.4",
    "@astrojs/mdx": "^5.0.3",
    "astro": "^6.1.1",
    "astro-pagefind": "^1.8.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@biomejs/biome": "^2.4.9",
    "@playwright/test": "1.58.2",
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.78.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write",
      "biome format --write"
    ],
    "src/**/*.astro": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
