---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getTagUrl, notDraft } from '../../lib/utils';

const posts = await getCollection('blog', notDraft);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags — Length³">
  <Header />
  <main class="tags-main" id="main-content">
    <header class="tags-header">
      <h1 class="page-title">Tags</h1>
      <p class="page-meta tags-subtitle">
        {sortedTags.length} topics across {posts.length} articles
      </p>
      <hr class="amber-rule" />
    </header>
    <ul class="tag-grid">
      {
        sortedTags.map(([tag, count]) => (
          <li>
            <a href={getTagUrl(tag)} class="tag-card" rel="tag">
              <span class="tag-name">#{tag}</span>
              <span class="tag-count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tags-main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .tags-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    margin-bottom: 0.5rem; /* page-title base in global.css; only spacing is local */
  }

  .tags-subtitle {
    margin-bottom: 1.25rem; /* page-meta base in global.css; only spacing is local */
  }

  .tag-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.75rem;
  }

  .tag-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .tag-card:hover,
  .tag-card:active {
    border-color: var(--amber);
    color: var(--amber);
  }

  .tag-name {
    color: inherit;
  }

  .tag-count {
    font-size: 0.75rem;
    color: var(--ink-2);
    background: var(--bg-2);
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
    min-width: 1.5rem;
    text-align: center;
  }

  @media (pointer: coarse) {
    .tag-card {
      min-height: 2.75rem; /* WCAG 2.5.8 */
    }
  }

  @media (max-width: 30rem) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
