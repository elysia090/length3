---
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import type { ProcessedPost, TagRoute } from '../../lib/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBlogIndex } from '../../lib/blog-index';

export const getStaticPaths = (async () => {
  return (await getBlogIndex()).tagRoutes.map((route) => ({
    params: { tag: route.canonicalSlug },
    props: { route },
  }));
}) satisfies GetStaticPaths;

const { route } = Astro.props as { route: TagRoute };
const { processedPostsById } = await getBlogIndex();
const processed: ProcessedPost[] = route.posts.map((post) => {
  const processedPost = processedPostsById.get(post.id);
  if (!processedPost) {
    throw new Error(`Missing processed post for "${post.id}".`);
  }
  return processedPost;
});

processed.sort((a, b) => b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf());
---

<BaseLayout title={`${route.name} — Length³`}>
  <Header />
  <Breadcrumb segments={[{ label: 'Length³', href: '/' }, { label: route.name }]} />
  <main class="tag-main" id="main-content">
    <header class="tag-header">
      <h1 class="page-title">#{route.name}</h1>
      <p class="page-meta tag-count">
        {processed.length} article{processed.length !== 1 ? 's' : ''}
      </p>
      <hr class="amber-rule" />
    </header>
    <section aria-label={`Articles tagged ${route.name}`}>
      {processed.map((p) => <ArticleCard post={p} />)}
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tag-main {
    max-width: var(--measure);
    margin: 0 auto;
    padding-block: 2rem 4rem;
    padding-inline: max(var(--page-gutter), env(safe-area-inset-left))
      max(var(--page-gutter), env(safe-area-inset-right));
  }

  .tag-header {
    margin-bottom: 2rem;
  }

  h1 {
    margin-bottom: 0.5rem; /* page-title base in global.css; only spacing is local */
  }

  .tag-count {
    margin-bottom: 1.25rem; /* page-meta base in global.css; only spacing is local */
  }
</style>
