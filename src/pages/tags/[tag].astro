---
export const prerender = true;

import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { ProcessedPost } from '../../lib/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { processPost, notDraft, buildTagIndex } from '../../lib/utils';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', notDraft);
  const { bySlug, names } = buildTagIndex(posts);
  return [...bySlug.entries()].map(([tagSlug, tagPosts]) => ({
    params: { tag: tagSlug },
    props: { tagPosts, tagName: names.get(tagSlug) ?? tagSlug },
  }));
}) satisfies GetStaticPaths;

const { tagPosts, tagName } = Astro.props;

const processed: ProcessedPost[] = tagPosts.map(processPost);

processed.sort((a, b) => b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf());
---

<BaseLayout title={`${tagName} — Length³`}>
  <Header />
  <Breadcrumb segments={[{ label: 'Length³', href: '/' }, { label: tagName }]} />
  <main class="tag-main" id="main-content">
    <header class="tag-header">
      <h1 class="page-title">#{tagName}</h1>
      <p class="page-meta tag-count">
        {processed.length} article{processed.length !== 1 ? 's' : ''}
      </p>
      <hr class="amber-rule" />
    </header>
    <section aria-label={`Articles tagged ${tagName}`}>
      {processed.map((p) => <ArticleCard post={p} />)}
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tag-main {
    max-width: var(--measure);
    margin: 0 auto;
    padding-block: 2rem 4rem;
    padding-inline: max(var(--page-gutter), env(safe-area-inset-left))
      max(var(--page-gutter), env(safe-area-inset-right));
  }

  .tag-header {
    margin-bottom: 2rem;
  }

  h1 {
    margin-bottom: 0.5rem; /* page-title base in global.css; only spacing is local */
  }

  .tag-count {
    margin-bottom: 1.25rem; /* page-meta base in global.css; only spacing is local */
  }
</style>
