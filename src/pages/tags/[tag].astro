---
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import { getBlogCatalog } from '../../features/catalog';
import type { ProcessedPost, TagRoute } from '../../features/catalog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArchiveStage, ArticleCard } from '../../features/archive';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const getStaticPaths = (async () => {
  const { tagPages } = await getBlogCatalog();
  return tagPages.map(({ route, processedPosts }) => ({
    params: { tag: route.canonicalSlug },
    props: { processedPosts, route },
  }));
}) satisfies GetStaticPaths;

const { route, processedPosts } = Astro.props as {
  route: TagRoute;
  processedPosts: ProcessedPost[];
};
// 番号と物差しはサイト全体のもの。タグで絞っても同じ記事は同じ番号、同じ大きさ。
const { catalogNumbers, maxReadingTime } = await getBlogCatalog();
---

<BaseLayout title={`${route.name} — Length³`}>
  <Header />
  <Breadcrumb segments={[{ label: 'Length³', href: '/' }, { label: route.name }]} measure />
  <main class="page-shell tag-main" id="main-content">
    <header class="page-header tag-header">
      <h1 class="page-title">#{route.name}</h1>
      <p class="page-meta tag-count">
        {processedPosts.length} article{processedPosts.length !== 1 ? 's' : ''}
      </p>
      <hr class="amber-rule" />
    </header>
    <ArchiveStage posts={processedPosts} catalogNumbers={catalogNumbers} />
    <section aria-label={`Articles tagged ${route.name}`}>
      {
        processedPosts.map((post) => (
          <ArticleCard
            post={post}
            number={catalogNumbers.get(post.slug) ?? 0}
            maxReadingTime={maxReadingTime}
          />
        ))
      }
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.5rem; /* page-title base in global.css; only spacing is local */
  }

  .tag-count {
    margin-bottom: 1.25rem; /* page-meta base in global.css; only spacing is local */
  }
</style>
