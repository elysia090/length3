---
export const prerender = true;

import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { ProcessedPost } from '../../types/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { toSlug, tagToSlug } from '../../lib/slugify';
import { estimateReadingTime } from '../../lib/reading-time';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagMap = new Map<string, typeof posts>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagToSlug(tag);
      if (!tagMap.has(slug)) tagMap.set(slug, []);
      tagMap.get(slug)!.push(post);
    }
  }

  return [...tagMap.entries()].map(([tagSlug, tagPosts]) => {
    const tagName = tagPosts[0]?.data.tags.find(
      (t) => tagToSlug(t) === tagSlug,
    ) ?? tagSlug;
    return {
      params: { tag: tagSlug },
      props: { tagPosts, tagName },
    };
  });
}) satisfies GetStaticPaths;

const { tagPosts, tagName } = Astro.props;

const processed: ProcessedPost[] = tagPosts.map((entry) => ({
  entry,
  slug: toSlug(entry.id),
  readingTime: estimateReadingTime(entry.body ?? ''),
  excerpt: entry.data.description,
}));

processed.sort(
  (a, b) => b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf(),
);
---

<BaseLayout title={`${tagName} — length3`}>
  <Header />
  <main class="tag-main">
    <header class="tag-header">
      <p class="tag-breadcrumb"><a href="/tags">Tags</a> /</p>
      <h1>{tagName}</h1>
      <p class="tag-count">{processed.length} article{processed.length !== 1 ? 's' : ''}</p>
    </header>
    <section aria-label={`Articles tagged ${tagName}`}>
      {processed.map((p) => <ArticleCard post={p} />)}
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tag-main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .tag-header {
    margin-bottom: 2rem;
  }

  .tag-breadcrumb {
    font-size: 0.875rem;
    color: var(--ink-2);
    margin-bottom: 0.5rem;
  }

  .tag-breadcrumb a {
    color: var(--amber);
  }

  .tag-breadcrumb a:hover {
    text-decoration: underline;
  }

  h1 {
    font-family: var(--font-display);  /* spec §2: Fraunces */
    font-size: 1.75rem;
    font-weight: 300;                  /* spec §2 */
    line-height: 1.25;
    margin-bottom: 0.25rem;
  }

  .tag-count {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
</style>
