---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — Length³" description="Page not found">
  <Header />
  <main class="not-found" id="main-content">
    <p class="not-found-code">404</p>
    <h1 class="not-found-title">Page not found</h1>
    <hr class="amber-rule not-found-rule" />
    <p class="not-found-body">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="not-found-link">← Back to articles</a>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .not-found-code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--amber);
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .not-found-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .not-found-rule {
    margin-bottom: 1.5rem;
  }

  .not-found-body {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .not-found-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    transition: color var(--transition-fast);
  }

  .not-found-link:hover {
    color: var(--amber);
  }
</style>
