---
// SSR only — no prerender
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/code.css';
---

<BaseLayout title="Editor — Length³" description="Live MDX editor">
  <div class="editor-root">

    <!-- LEFT: dark editor pane -->
    <div class="editor-pane" role="region" aria-label="MDX source editor">
      <div class="editor-toolbar">
        <span class="editor-breadcrumb">
          <span class="editor-bc-icon">◆</span>
          <span class="editor-bc-sep">articles /</span>
          <span class="editor-bc-file" id="editor-filename">untitled.mdx</span>
        </span>
        <div class="editor-toolbar-actions">
          <button class="editor-action-btn" id="discard-btn">Discard</button>
          <button class="editor-action-btn" id="preview-btn">Preview</button>
          <button class="editor-action-btn editor-publish-btn" id="publish-btn">Publish →</button>
        </div>
      </div>

      <div class="editor-body" id="editor-mount"></div>

      <div class="editor-statusbar" aria-label="Editor status">
        <span class="status-item status-lang">MDX</span>
        <span class="status-sep">|</span>
        <span class="status-item">UTF-8</span>
        <span class="status-sep">|</span>
        <span class="status-item" id="status-pos">Ln 1, Col 1</span>
        <span class="status-sep">|</span>
        <span class="status-item status-ok">Prettier ✓</span>
        <span class="status-sep">|</span>
        <span class="status-item status-ok">Biome ✓</span>
        <span class="status-sep">|</span>
        <span class="status-item status-ok">astro check — 0 errors</span>
      </div>
    </div>

    <!-- RIGHT: light preview pane -->
    <div class="preview-pane" role="region" aria-label="Live preview">
      <div class="preview-toolbar">
        <span class="preview-breadcrumb">
          <a href="/">Length³</a>
          <span class="pbc-sep">/</span>
          <span>editor</span>
          <span class="pbc-sep">/</span>
          <span>preview</span>
        </span>
      </div>
      <div class="preview-body">
        <div class="preview-content prose" id="preview-output">
          <p class="preview-placeholder">Start writing MDX…</p>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  import { EditorView, basicSetup } from 'codemirror';
  import { EditorState } from '@codemirror/state';
  import { markdown } from '@codemirror/lang-markdown';
  import { oneDark } from '@codemirror/theme-one-dark';

  const mount = document.getElementById('editor-mount');
  const output = document.getElementById('preview-output');
  const posEl = document.getElementById('status-pos');

  const initialDoc = `---
title: Untitled
tags: []
date: ${new Date().toISOString().slice(0, 10)}
---

## Introduction

Start writing here.
`;

  if (mount && output) {
    const state = EditorState.create({
      doc: initialDoc,
      extensions: [
        basicSetup,
        markdown(),
        oneDark,
        EditorView.updateListener.of((update) => {
          if (update.selectionSet || update.docChanged) {
            const pos = update.state.selection.main.head;
            const line = update.state.doc.lineAt(pos);
            const col = pos - line.from + 1;
            if (posEl) posEl.textContent = `Ln ${line.number}, Col ${col}`;
          }
          if (update.docChanged) {
            const text = update.state.doc.toString();
            renderPreview(text);
          }
        }),
      ],
    });

    new EditorView({ state, parent: mount });
    renderPreview(initialDoc);
  }

  function renderPreview(text: string) {
    if (!output) return;
    // Strip frontmatter
    const body = text.replace(/^---[\s\S]*?---\n?/, '').trim();
    // Naive markdown → HTML (dev preview only)
    const html = body
      .split('\n')
      .map((line) => {
        if (line.startsWith('### ')) return `<h3>${esc(line.slice(4))}</h3>`;
        if (line.startsWith('## ')) return `<h2>${esc(line.slice(3))}</h2>`;
        if (line.startsWith('# ')) return `<h1>${esc(line.slice(2))}</h1>`;
        if (line.startsWith('> ')) return `<blockquote><p>${esc(line.slice(2))}</p></blockquote>`;
        if (line.trim() === '') return '<br>';
        // inline code
        const escaped = esc(line).replace(/`([^`]+)`/g, '<code>$1</code>');
        return `<p>${escaped}</p>`;
      })
      .join('');
    output.innerHTML = html;
  }

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }
</script>

<style>
  .editor-root {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100dvh;
    overflow: hidden;
  }

  /* ── Left: editor ── */
  .editor-pane {
    display: flex;
    flex-direction: column;
    background: #18181b;
    color: #e5e7eb;
    overflow: hidden;
  }

  .editor-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #27272a;
    flex-shrink: 0;
  }

  .editor-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #71717a;
  }

  .editor-bc-icon {
    color: var(--color-accent);
    font-size: 0.5rem;
  }

  .editor-bc-sep {
    color: #3f3f46;
  }

  .editor-bc-file {
    color: #a1a1aa;
  }

  .editor-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .editor-action-btn {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid #3f3f46;
    border-radius: 1px;
    background: transparent;
    color: #a1a1aa;
    cursor: pointer;
    transition: border-color 0.1s, color 0.1s;
  }

  .editor-action-btn:hover {
    border-color: #71717a;
    color: #e5e7eb;
  }

  .editor-publish-btn {
    border-color: var(--color-accent) !important;
    color: var(--color-accent) !important;
    font-weight: 500;
  }

  .editor-publish-btn:hover {
    background: var(--color-accent);
    color: #18181b !important;
  }

  .editor-body {
    flex: 1;
    overflow: hidden;
  }

  .editor-body :global(.cm-editor) {
    height: 100%;
    font-size: 13px;
  }

  .editor-body :global(.cm-scroller) {
    overflow: auto;
    font-family: var(--font-mono);
  }

  /* Status bar */
  .editor-statusbar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0.3rem 1rem;
    background: var(--color-accent);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .status-item {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: #1a1917;
    letter-spacing: 0.02em;
    padding: 0 0.3rem;
  }

  .status-lang {
    font-weight: 600;
  }

  .status-ok { color: #431407; }

  .status-sep {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(26, 25, 23, 0.4);
  }

  /* ── Right: preview ── */
  .preview-pane {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border-left: 1px solid var(--color-border);
    overflow: hidden;
  }

  .preview-toolbar {
    padding: 0.5rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .preview-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .preview-breadcrumb a {
    color: var(--color-muted);
    transition: color 0.1s;
  }

  .preview-breadcrumb a:hover {
    color: var(--color-accent);
  }

  .pbc-sep {
    color: var(--color-border);
  }

  .preview-body {
    flex: 1;
    overflow-y: auto;
    padding: 2rem 2.5rem;
  }

  .preview-content {
    max-width: var(--measure);
  }

  .preview-placeholder {
    color: var(--color-muted);
    font-style: italic;
    font-size: 0.9375rem;
  }

  @media (max-width: 700px) {
    .editor-root {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }
  }
</style>
