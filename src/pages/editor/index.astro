---
// SSR only — no prerender
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/code.css';
---

<BaseLayout title="Editor — Length³" description="Live MDX editor">
  <div class="editor-root">

    <!-- TOP BAR — spec §4: 40px, #201d19 bg -->
    <div class="editor-topbar">
      <div class="editor-topbar-left">
        <!-- spec §4: Logo "L³" in amber -->
        <span class="editor-logo">L<sup>³</sup></span>
        <span class="editor-bc-sep">articles /</span>
        <span class="editor-bc-file" id="editor-filename">untitled.mdx</span>
      </div>
      <div class="editor-topbar-actions">
        <!-- spec §4: amber is not used on any button -->
        <button class="editor-btn editor-btn-discard" id="discard-btn">Discard</button>
        <button class="editor-btn editor-btn-preview" id="preview-btn">Preview</button>
        <button class="editor-btn editor-btn-publish" id="publish-btn" aria-label="Publish article">Publish →</button>
      </div>
    </div>

    <!-- Mobile tabs — APG Tabs pattern, visible < 640px -->
    <div class="editor-tabs" role="tablist" aria-label="Editor panels">
      <button role="tab" aria-selected="true" aria-controls="editor-pane" id="tab-edit" class="editor-tab">Edit</button>
      <button role="tab" aria-selected="false" aria-controls="preview-pane" id="tab-preview" class="editor-tab">Preview</button>
    </div>

    <!-- MAIN: editor + preview -->
    <div class="editor-main">
      <!-- LEFT: dark editor pane — spec §4 -->
      <div class="editor-pane tab-active" id="editor-pane" role="tabpanel" aria-label="MDX source editor">
        <div class="editor-body" id="editor-mount"></div>
      </div>

      <!-- RIGHT: light preview pane — spec §4 -->
      <div class="preview-pane" id="preview-pane" role="tabpanel" aria-label="Live preview">
        <div class="preview-body">
          <div class="preview-content prose" id="preview-output">
            <p class="preview-placeholder">Start writing MDX…</p>
          </div>
        </div>
      </div>
    </div>

    <!-- STATUS BAR — spec §4: 24px, #1a1714, amber never used here -->
    <div class="editor-statusbar" aria-label="Editor status">
      <span class="status-item">UTF-8</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item" id="status-pos">Ln 1 · Col 1</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item">Prettier ✓</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item">Biome ✓</span>
      <span class="status-right">astro check: 0 errors</span>
    </div>

  </div>
</BaseLayout>

<script>
  import { EditorView, basicSetup, type ViewUpdate } from 'codemirror';
  import { EditorState, RangeSetBuilder } from '@codemirror/state';
  import { Decoration, type DecorationSet, ViewPlugin } from '@codemirror/view';
  import { markdown } from '@codemirror/lang-markdown';
  import { HighlightStyle, syntaxHighlighting } from '@codemirror/language';
  import { tags } from '@lezer/highlight';

  const mount = document.getElementById('editor-mount');
  const output = document.getElementById('preview-output');
  const posEl = document.getElementById('status-pos');
  let docChanged = false;

  // Nielsen H5: warn before leaving with unsaved changes
  window.addEventListener('beforeunload', (e) => {
    if (docChanged) e.preventDefault();
  });

  // Nielsen H3: Discard confirmation
  document.getElementById('discard-btn')?.addEventListener('click', (e) => {
    if (docChanged && !confirm('Discard all changes?')) {
      e.preventDefault();
      e.stopPropagation();
    }
  });

  // Nielsen H1: Publish feedback
  document.getElementById('publish-btn')?.addEventListener('click', () => {
    const btn = document.getElementById('publish-btn');
    if (btn) {
      btn.textContent = 'Published!';
      setTimeout(() => { btn.textContent = 'Publish →'; }, 1500);
    }
  });

  const initialDoc = `---
title: Untitled
tags: []
date: ${new Date().toISOString().slice(0, 10)}
---

## Introduction

Start writing here.
`;

  // ── Custom theme — spec §4 ────────────────────────────────────
  const length3Theme = EditorView.theme({
    '&': {
      backgroundColor: '#181511',   /* --editor-bg */
      color: '#c8c4be',
    },
    '.cm-content': { caretColor: '#d4820a' },
    '.cm-cursor': { borderLeftColor: '#d4820a', borderLeftWidth: '2px' },
    '.cm-activeLine': { backgroundColor: 'rgba(255,255,255,0.025)' },
    '.cm-activeLineGutter': { backgroundColor: 'transparent', color: '#8a8070' },
    '.cm-gutters': {
      backgroundColor: '#181511',
      color: '#3a3630',
      border: 'none',
      width: '40px',
    },
    '.cm-lineNumbers .cm-gutterElement': { paddingRight: '8px' },
    '.cm-selectionBackground': { backgroundColor: 'rgba(212,130,10,0.2)' },
    '&.cm-focused .cm-selectionBackground': { backgroundColor: 'rgba(212,130,10,0.25)' },
    '.cm-line': { paddingLeft: '8px' },
  }, { dark: true });

  // ── Syntax highlight — spec §4 ────────────────────────────────
  const length3Highlight = HighlightStyle.define([
    // Frontmatter delimiters (---)
    { tag: tags.processingInstruction, color: '#9a9690' },
    // YAML keys
    { tag: tags.attributeName, color: '#7a9ab8' },
    { tag: tags.propertyName, color: '#7a9ab8' },
    // YAML values / strings
    { tag: tags.string, color: '#7ec49a' },
    { tag: tags.number, color: '#7ec49a' },
    { tag: tags.bool, color: '#7ec49a' },
    // Markdown H1
    { tag: tags.heading1, color: '#e8a030', fontWeight: '500' },
    // Markdown H2
    { tag: tags.heading2, color: '#d4820a', fontWeight: '400' },
    // Markdown H3–H6
    { tag: tags.heading3, color: '#d4820a' },
    { tag: tags.heading4, color: '#d4820a' },
    // Code / keywords
    { tag: tags.keyword, color: '#d4820a' },
    { tag: tags.operator, color: '#d4820a' },
    // Inline code content
    { tag: tags.monospace, color: '#e8a030' },
    // Function names
    { tag: tags.function(tags.name), color: '#8bb8e8' },
    { tag: tags.function(tags.variableName), color: '#8bb8e8' },
    // Comments
    { tag: tags.comment, color: '#3d3a34', fontStyle: 'italic' },
    // Links / URLs
    { tag: tags.url, color: '#7ec49a', textDecoration: 'underline' },
    { tag: tags.link, color: '#7a9ab8' },
    // Emphasis
    { tag: tags.emphasis, fontStyle: 'italic', color: '#c8c4be' },
    { tag: tags.strong, fontWeight: 'bold', color: '#c8c4be' },
    // Default fallback
    { tag: tags.name, color: '#c8c4be' },
    { tag: tags.variableName, color: '#c8c4be' },
    { tag: tags.content, color: '#c8c4be' },
    { tag: tags.atom, color: '#7ec49a' },
    { tag: tags.meta, color: '#9a9690' },
  ]);

  // ── Frontmatter YAML decoration — colorize keys/values within --- blocks ──
  const fmKeyMark = Decoration.mark({ class: 'cm-fm-key' });
  const fmValMark = Decoration.mark({ class: 'cm-fm-val' });
  const fmDelimMark = Decoration.mark({ class: 'cm-fm-delim' });

  function buildFrontmatterDecos(view: EditorView): DecorationSet {
    const builder = new RangeSetBuilder<Decoration>();
    const doc = view.state.doc;
    const text = doc.toString();
    // Detect frontmatter: must start at line 1 with ---
    if (!text.startsWith('---')) return builder.finish();
    const endIdx = text.indexOf('\n---', 3);
    if (endIdx === -1) return builder.finish();
    const fmEnd = endIdx + 4; // include closing ---\n

    for (let i = 1; i <= doc.lines; i++) {
      const line = doc.line(i);
      if (line.from >= fmEnd) break;
      const lineText = line.text;

      if (lineText.trim() === '---') {
        // Delimiter line
        builder.add(line.from, line.to, fmDelimMark);
      } else {
        // YAML key: value
        const colonIdx = lineText.indexOf(':');
        if (colonIdx > 0) {
          builder.add(line.from, line.from + colonIdx, fmKeyMark);
          const valStart = colonIdx + 1;
          const valText = lineText.slice(valStart);
          if (valText.trim().length > 0) {
            // Find first non-space after colon
            const trimOffset = valText.length - valText.trimStart().length;
            builder.add(line.from + valStart + trimOffset, line.to, fmValMark);
          }
        }
      }
    }
    return builder.finish();
  }

  const frontmatterPlugin = ViewPlugin.fromClass(
    class {
      decorations: DecorationSet;
      constructor(view: EditorView) {
        this.decorations = buildFrontmatterDecos(view);
      }
      update(update: ViewUpdate) {
        if (update.docChanged || update.viewportChanged) {
          this.decorations = buildFrontmatterDecos(update.view);
        }
      }
    },
    { decorations: (v) => v.decorations },
  );

  if (mount && output) {
    const state = EditorState.create({
      doc: initialDoc,
      extensions: [
        basicSetup,
        markdown(),
        length3Theme,
        syntaxHighlighting(length3Highlight),
        frontmatterPlugin,
        EditorView.updateListener.of((update) => {
          if (update.selectionSet || update.docChanged) {
            const pos = update.state.selection.main.head;
            const line = update.state.doc.lineAt(pos);
            const col = pos - line.from + 1;
            if (posEl) posEl.textContent = `Ln ${line.number} · Col ${col}`;
          }
          if (update.docChanged) {
            docChanged = true;
            const text = update.state.doc.toString();
            renderPreview(text);
          }
        }),
      ],
    });

    new EditorView({ state, parent: mount });
    renderPreview(initialDoc);
  }

  function renderPreview(text: string) {
    if (!output) return;
    // Extract frontmatter metadata
    let title = '';
    const fmMatch = text.match(/^---\n([\s\S]*?)\n---/);
    if (fmMatch) {
      const titleMatch = fmMatch[1].match(/^title:\s*(.+)$/m);
      if (titleMatch) title = titleMatch[1].trim();
    }
    // Strip frontmatter
    const body = text.replace(/^---[\s\S]*?---\n?/, '').trim();
    // Naive markdown → HTML (dev preview only; blank lines become paragraph breaks via CSS margin)
    const bodyHtml = body.split('\n')
      .map((line) => {
        if (line.startsWith('### ')) return `<h3>${esc(line.slice(4))}</h3>`;
        if (line.startsWith('## '))  return `<h2>${esc(line.slice(3))}</h2>`;
        if (line.startsWith('# '))   return `<h1>${esc(line.slice(2))}</h1>`;
        if (line.startsWith('> '))   return `<blockquote><p>${esc(line.slice(2))}</p></blockquote>`;
        if (line.trim() === '')      return '';
        return `<p>${esc(line).replace(/`([^`]+)`/g, '<code>$1</code>')}</p>`;
      })
      .filter(Boolean)
      .join('');
    // Build article-header if title exists, matching article page structure
    const headerHtml = title
      ? `<header class="article-header"><h1>${esc(title)}</h1><hr class="article-header-hr"></header>`
      : '';
    output.innerHTML = headerHtml + bodyHtml;
  }

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  // ── Mobile tab switching — APG Tabs pattern ──────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('.editor-tab');
  const editorPane = document.getElementById('editor-pane');
  const previewPane = document.getElementById('preview-pane');

  function activateTab(tab: HTMLButtonElement) {
    for (const t of tabs) {
      t.setAttribute('aria-selected', String(t === tab));
      t.tabIndex = t === tab ? 0 : -1;
    }
    if (editorPane && previewPane) {
      const isEdit = tab.id === 'tab-edit';
      editorPane.classList.toggle('tab-active', isEdit);
      previewPane.classList.toggle('tab-active', !isEdit);
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (e) => {
      const tabArr = [...tabs];
      const idx = tabArr.indexOf(tab);
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const next = e.key === 'ArrowRight' ? tabArr[(idx + 1) % tabArr.length]! : tabArr[(idx - 1 + tabArr.length) % tabArr.length]!;
        next.focus();
        activateTab(next);
      }
    });
  }
</script>

<style>
  /* ── Root: full viewport, 3 rows (topbar / main / statusbar) ── */
  .editor-root {
    display: grid;
    grid-template-rows: 40px 1fr 24px;   /* spec §4 */
    height: 100dvh;
    overflow: hidden;
    background: var(--editor-bg);
  }

  /* ── Top bar — spec §4: 40px, #201d19 ── */
  .editor-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    background: #201d19;   /* spec §4: slightly lighter than Editor-BG */
    border-bottom: 1px solid #252118;
    flex-shrink: 0;
    height: 40px;
  }

  .editor-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;                  /* 8px — grid aligned */
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  /* spec §4: L³ logo in amber */
  .editor-logo {
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .editor-logo sup {
    font-size: 0.6em;
    vertical-align: super;
    line-height: 0;
  }

  .editor-bc-sep {
    color: #3a3630;   /* spec §4: Ink-3 dark equivalent */
  }

  .editor-bc-file {
    color: var(--ink-2);   /* upgraded from Ink-3 for readability on dark bg */
  }

  .editor-topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* spec §4: amber not on any button */
  .editor-btn {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.5rem 0.75rem;      /* WCAG 2.5.8: touch target */
    background: transparent;
    cursor: pointer;
    transition: color 80ms ease;
  }

  /* Dark-context button colors — spec §4 role hierarchy preserved:
     Discard (least prominent) → Preview → Publish (most prominent)
     Tokens are interpreted for dark background readability */
  .editor-btn-discard {
    border: none;
    color: #9a9690;   /* upgraded for WCAG AA contrast on dark bg */
  }

  .editor-btn-discard:hover {
    color: #c8c4be;
  }

  .editor-btn-preview {
    border: 1px solid #3a3630;
    border-radius: 2px;
    color: #9a9690;   /* Ink-2 equivalent on dark: secondary */
  }

  .editor-btn-preview:hover {
    border-color: #52504a;
    color: #c8c4be;
  }

  /* spec §4: Publish — Ink text (primary/brightest), Rule border, NOT amber */
  .editor-btn-publish {
    border: 1px solid #52504a;
    border-radius: 2px;
    color: #e2ddd8;   /* Ink equivalent on dark: primary, most readable */
  }

  .editor-btn-publish:hover {
    border-color: #9a9690;
    color: #f9f8f5;
  }

  .editor-btn:active {
    opacity: 0.8;
  }

  .editor-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* ── Main: 50/50 split ── */
  .editor-main {
    display: grid;
    grid-template-columns: 1fr 1fr;   /* spec §4: exactly 50/50 */
    overflow: hidden;
  }

  /* ── Editor pane (dark) — spec §4 ── */
  .editor-pane {
    display: flex;
    flex-direction: column;
    background: var(--editor-bg);   /* #181511 */
    border-right: 1px solid #252118;
    overflow: hidden;
  }

  .editor-body {
    flex: 1;
    overflow: hidden;
  }

  .editor-body :global(.cm-editor) {
    height: 100%;
    font-size: 13px;
  }

  .editor-body :global(.cm-scroller) {
    overflow: auto;
    font-family: var(--font-mono);
  }

  /* Frontmatter YAML decoration — spec §4: key=muted blue, value=muted green */
  .editor-body :global(.cm-fm-delim) { color: #9a9690; }
  .editor-body :global(.cm-fm-key) { color: #7a9ab8; }
  .editor-body :global(.cm-fm-val) { color: #7ec49a; }

  /* ── Preview pane (light) — spec §4: BG, padding 40px 48px ── */
  .preview-pane {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    overflow: hidden;
  }

  .preview-body {
    flex: 1;
    overflow-y: auto;
    padding: 40px 48px;   /* spec §4 */
  }

  .preview-content {
    max-width: var(--measure);
  }

  .preview-placeholder {
    color: var(--ink-2);           /* upgraded from Ink-3 for WCAG AA */
    font-style: italic;
    font-size: 0.9375rem;
  }

  /* ── Status bar — spec §4: 24px, #1a1714, amber never used ── */
  .editor-statusbar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 16px;
    background: #1a1714;   /* spec §4: slightly darker than Editor-BG */
    height: 24px;
    flex-shrink: 0;
  }

  .status-item {
    font-family: var(--font-mono);
    font-size: 0.6875rem;  /* bumped from 0.65rem for readability */
    color: #7a776f;        /* midpoint between Ink-3 and Ink-2 for dark bg legibility */
    padding: 0 0.25rem;           /* 4px — grid aligned */
    letter-spacing: 0.02em;
  }

  .status-sep {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #3a3630;
  }

  .status-right {
    font-family: var(--font-mono);
    font-size: 0.6875rem;  /* bumped from 0.65rem for readability */
    color: #7a776f;        /* midpoint between Ink-3 and Ink-2 for dark bg legibility */
    margin-left: auto;
    letter-spacing: 0.02em;
  }

  /* ── Editor tabs — hidden on desktop, visible on mobile ── */
  .editor-tabs {
    display: none;
  }

  .editor-tab {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.5rem 1rem;
    border: none;
    background: transparent;
    color: #9a9690;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 80ms ease, border-color 80ms ease;
  }

  .editor-tab[aria-selected='true'] {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }

  /* ── Mobile: tab mode below 640px — spec §8 ── */
  @media (max-width: 639px) {
    .editor-tabs {
      display: flex;
      background: #201d19;
      border-bottom: 1px solid #252118;
    }

    .editor-root {
      grid-template-rows: 40px auto 1fr 24px;
    }

    .editor-main {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
    }

    .editor-pane {
      display: none;
      border-right: none;
    }

    .preview-pane {
      display: none;
    }

    .editor-pane.tab-active,
    .preview-pane.tab-active {
      display: flex;
    }
  }
</style>
