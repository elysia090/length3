---
// SSR only — no prerender
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/code.css';
---

<BaseLayout title="Editor — Length³" description="Live MDX editor">
  <div class="editor-root">

    <!-- TOP BAR — spec §4: 40px, #201d19 bg -->
    <div class="editor-topbar">
      <div class="editor-topbar-left">
        <!-- spec §4: Logo "L³" in amber -->
        <span class="editor-logo">L<sup>³</sup></span>
        <span class="editor-bc-sep">articles /</span>
        <span class="editor-bc-file" id="editor-filename">untitled.mdx</span>
      </div>
      <div class="editor-topbar-actions">
        <!-- spec §4: amber is not used on any button -->
        <button class="editor-btn editor-btn-discard" id="discard-btn">Discard</button>
        <button class="editor-btn editor-btn-preview" id="preview-btn">Preview</button>
        <button class="editor-btn editor-btn-publish" id="publish-btn">Publish →</button>
      </div>
    </div>

    <!-- MAIN: editor + preview -->
    <div class="editor-main">
      <!-- LEFT: dark editor pane — spec §4 -->
      <div class="editor-pane" role="region" aria-label="MDX source editor">
        <div class="editor-body" id="editor-mount"></div>
      </div>

      <!-- RIGHT: light preview pane — spec §4 -->
      <div class="preview-pane" role="region" aria-label="Live preview">
        <div class="preview-body">
          <div class="preview-content prose" id="preview-output">
            <p class="preview-placeholder">Start writing MDX…</p>
          </div>
        </div>
      </div>
    </div>

    <!-- STATUS BAR — spec §4: 24px, #1a1714, amber never used here -->
    <div class="editor-statusbar" aria-label="Editor status">
      <span class="status-item">UTF-8</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item" id="status-pos">Ln 1 · Col 1</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item">Prettier ✓</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item">Biome ✓</span>
      <span class="status-right">astro check: 0 errors</span>
    </div>

  </div>
</BaseLayout>

<script>
  import { EditorView, basicSetup } from 'codemirror';
  import { EditorState } from '@codemirror/state';
  import { markdown } from '@codemirror/lang-markdown';
  import { oneDark } from '@codemirror/theme-one-dark';

  const mount = document.getElementById('editor-mount');
  const output = document.getElementById('preview-output');
  const posEl = document.getElementById('status-pos');

  const initialDoc = `---
title: Untitled
tags: []
date: ${new Date().toISOString().slice(0, 10)}
---

## Introduction

Start writing here.
`;

  if (mount && output) {
    const state = EditorState.create({
      doc: initialDoc,
      extensions: [
        basicSetup,
        markdown(),
        oneDark,
        EditorView.updateListener.of((update) => {
          if (update.selectionSet || update.docChanged) {
            const pos = update.state.selection.main.head;
            const line = update.state.doc.lineAt(pos);
            const col = pos - line.from + 1;
            if (posEl) posEl.textContent = `Ln ${line.number} · Col ${col}`;
          }
          if (update.docChanged) {
            const text = update.state.doc.toString();
            renderPreview(text);
          }
        }),
      ],
    });

    new EditorView({ state, parent: mount });
    renderPreview(initialDoc);
  }

  function renderPreview(text: string) {
    if (!output) return;
    // Strip frontmatter
    const body = text.replace(/^---[\s\S]*?---\n?/, '').trim();
    // Naive markdown → HTML (dev preview only)
    const html = body
      .split('\n')
      .map((line) => {
        if (line.startsWith('### ')) return `<h3>${esc(line.slice(4))}</h3>`;
        if (line.startsWith('## ')) return `<h2>${esc(line.slice(3))}</h2>`;
        if (line.startsWith('# ')) return `<h1>${esc(line.slice(2))}</h1>`;
        if (line.startsWith('> ')) return `<blockquote><p>${esc(line.slice(2))}</p></blockquote>`;
        if (line.trim() === '') return '<br>';
        const escaped = esc(line).replace(/`([^`]+)`/g, '<code>$1</code>');
        return `<p>${escaped}</p>`;
      })
      .join('');
    output.innerHTML = html;
  }

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }
</script>

<style>
  /* ── Root: full viewport, 3 rows (topbar / main / statusbar) ── */
  .editor-root {
    display: grid;
    grid-template-rows: 40px 1fr 24px;   /* spec §4 */
    height: 100dvh;
    overflow: hidden;
    background: var(--editor-bg);
  }

  /* ── Top bar — spec §4: 40px, #201d19 ── */
  .editor-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    background: #201d19;   /* spec §4: slightly lighter than Editor-BG */
    border-bottom: 1px solid #252118;
    flex-shrink: 0;
    height: 40px;
  }

  .editor-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  /* spec §4: L³ logo in amber */
  .editor-logo {
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .editor-logo sup {
    font-size: 0.6em;
    vertical-align: super;
    line-height: 0;
  }

  .editor-bc-sep {
    color: #3a3630;   /* spec §4: Ink-3 dark equivalent */
  }

  .editor-bc-file {
    color: var(--ink-3);
  }

  .editor-topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* spec §4: amber not on any button */
  .editor-btn {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.2rem 0.6rem;
    background: transparent;
    cursor: pointer;
    transition: color 80ms ease;
  }

  .editor-btn-discard {
    border: none;
    color: var(--ink-3);   /* spec §4: Ink-3, text only, no border */
  }

  .editor-btn-discard:hover {
    color: #9a9690;
  }

  .editor-btn-preview {
    border: 1px solid #3a3630;   /* spec §4: Rule border */
    border-radius: 2px;
    color: var(--ink-2);
  }

  .editor-btn-preview:hover {
    border-color: #52504a;
    color: #9a9690;
  }

  .editor-btn-publish {
    border: 1px solid #3a3630;   /* spec §4: Rule border, NOT amber */
    border-radius: 2px;
    color: var(--ink);
  }

  .editor-btn-publish:hover {
    border-color: #52504a;
    color: #9a9690;
  }

  /* ── Main: 50/50 split ── */
  .editor-main {
    display: grid;
    grid-template-columns: 1fr 1fr;   /* spec §4: exactly 50/50 */
    overflow: hidden;
  }

  /* ── Editor pane (dark) — spec §4 ── */
  .editor-pane {
    display: flex;
    flex-direction: column;
    background: var(--editor-bg);   /* #181511 */
    border-right: 1px solid #252118;
    overflow: hidden;
  }

  .editor-body {
    flex: 1;
    overflow: hidden;
  }

  .editor-body :global(.cm-editor) {
    height: 100%;
    font-size: 13px;
  }

  .editor-body :global(.cm-scroller) {
    overflow: auto;
    font-family: var(--font-mono);
  }

  /* ── Preview pane (light) — spec §4: BG, padding 40px 48px ── */
  .preview-pane {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    overflow: hidden;
  }

  .preview-body {
    flex: 1;
    overflow-y: auto;
    padding: 40px 48px;   /* spec §4 */
  }

  .preview-content {
    max-width: var(--measure);
  }

  .preview-placeholder {
    color: var(--ink-3);
    font-style: italic;
    font-size: 0.9375rem;
  }

  /* ── Status bar — spec §4: 24px, #1a1714, amber never used ── */
  .editor-statusbar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 16px;
    background: #1a1714;   /* spec §4: slightly darker than Editor-BG */
    height: 24px;
    flex-shrink: 0;
  }

  .status-item {
    font-family: var(--font-mono);
    font-size: 0.65rem;   /* spec §4: 0.65rem */
    color: var(--ink-3);
    padding: 0 0.3rem;
    letter-spacing: 0.02em;
  }

  .status-sep {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #3a3630;
  }

  .status-right {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-3);
    margin-left: auto;
    letter-spacing: 0.02em;
  }

  /* ── Mobile: tab mode below 640px — spec §8 ── */
  @media (max-width: 639px) {
    .editor-root {
      grid-template-rows: 40px auto 1fr 24px;
    }

    .editor-main {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    .editor-pane {
      display: none;   /* Tab mode: managed by JS tab switch */
      border-right: none;
      border-bottom: 1px solid #252118;
    }

    .editor-pane.tab-active,
    .preview-pane.tab-active {
      display: flex;
    }
  }
</style>
