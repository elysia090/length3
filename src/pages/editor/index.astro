---
export const prerender = false; // SSR only
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/code.css';
---

<BaseLayout title="Editor — Length³" description="Live MDX editor">
  <div class="editor-root" id="main-content">
    <!-- TOP BAR — spec §4: 40px, var(--editor-topbar-bg) -->
    <div class="editor-topbar">
      <div class="editor-topbar-left">
        <!-- spec §4: Logo "L³" in amber -->
        <span class="editor-logo">L<sup>³</sup></span>
        <span class="editor-bc-sep">articles /</span>
        <span class="editor-bc-file" id="editor-filename">untitled.mdx</span>
      </div>
      <div class="editor-topbar-actions">
        <!-- spec §4: amber is not used on any button -->
        <button class="editor-btn editor-btn-discard" id="discard-btn">Discard</button>
        <button class="editor-btn editor-btn-publish" id="publish-btn" aria-label="Publish article"
          >Publish →</button
        >
      </div>
    </div>

    <!-- Mobile tabs — APG Tabs pattern, visible < 640px -->
    <div class="editor-tabs" role="tablist" aria-label="Editor panels">
      <button
        role="tab"
        aria-selected="true"
        aria-controls="editor-pane"
        id="tab-edit"
        class="editor-tab">Edit</button
      >
      <button
        role="tab"
        aria-selected="false"
        aria-controls="preview-pane"
        id="tab-preview"
        class="editor-tab">Preview</button
      >
    </div>

    <!-- MAIN: editor + preview -->
    <div class="editor-main">
      <!-- LEFT: dark editor pane — spec §4 -->
      <div
        class="editor-pane tab-active"
        id="editor-pane"
        role="tabpanel"
        aria-label="MDX source editor"
      >
        <div class="editor-body" id="editor-mount"></div>
      </div>

      <!-- RIGHT: light preview pane — spec §4 -->
      <div class="preview-pane" id="preview-pane" role="tabpanel" aria-label="Live preview">
        <div class="preview-body">
          <div class="preview-content prose" id="preview-output">
            <p class="preview-placeholder">Start writing MDX…</p>
          </div>
        </div>
      </div>
    </div>

    <!-- STATUS BAR — spec §4: 24px, var(--editor-statusbar-bg), amber never used here -->
    <div class="editor-statusbar" aria-label="Editor status">
      <span class="status-item">UTF-8</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item" id="status-pos">Ln 1 · Col 1</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <span class="status-item" id="status-count">0 chars</span>
    </div>
  </div>
</BaseLayout>

<script>
  import { EditorView, basicSetup } from 'codemirror';
  import { EditorState } from '@codemirror/state';
  import { markdown } from '@codemirror/lang-markdown';
  import { syntaxHighlighting } from '@codemirror/language';
  import { length3Theme, length3Highlight } from '../../lib/editor/theme';
  import { frontmatterPlugin } from '../../lib/editor/frontmatter-plugin';
  import { parseFrontmatter, renderPreview } from '../../lib/editor/preview';

  const mount = document.getElementById('editor-mount');
  const output = document.getElementById('preview-output') as HTMLElement | null;
  const posEl = document.getElementById('status-pos');
  const countEl = document.getElementById('status-count');
  let docChanged = false;

  // Nielsen H5: warn before leaving with unsaved changes
  window.addEventListener('beforeunload', (e) => {
    if (docChanged) e.preventDefault();
  });

  // Nielsen H3: Discard confirmation
  document.getElementById('discard-btn')?.addEventListener('click', (e) => {
    if (docChanged && !confirm('Discard all changes?')) {
      e.preventDefault();
      e.stopPropagation();
    }
  });

  // Nielsen H1 + H3: Publish confirmation then feedback
  const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement | null;
  publishBtn?.addEventListener('click', () => {
    if (!publishBtn) return;
    if (!confirm('Publish this article?')) return;
    publishBtn.textContent = 'Published!';
    // Clear the dirty flag so beforeunload no longer warns after publishing
    docChanged = false;
    setTimeout(() => {
      publishBtn.textContent = 'Publish →';
    }, 1500);
  });

  const initialDoc = `---
title: Untitled
tags: []
date: ${new Date().toISOString().slice(0, 10)}
---

## Introduction

Start writing here.
`;

  // body: already-extracted body text (no frontmatter), so we avoid a second
  // parseFrontmatter() call inside updateStatusCount.
  function updateStatusCount(body: string) {
    if (!countEl) return;
    countEl.textContent = `${body.replace(/\s/g, '').length} chars`;
  }

  if (mount && output) {
    // Timer handle for debouncing the expensive marked.parse render.
    let previewTimer: ReturnType<typeof setTimeout> | undefined;

    const state = EditorState.create({
      doc: initialDoc,
      extensions: [
        basicSetup,
        markdown(),
        length3Theme,
        syntaxHighlighting(length3Highlight),
        frontmatterPlugin,
        EditorView.updateListener.of((update) => {
          if (update.selectionSet || update.docChanged) {
            const pos = update.state.selection.main.head;
            const line = update.state.doc.lineAt(pos);
            const col = pos - line.from + 1;
            if (posEl) posEl.textContent = `Ln ${line.number} · Col ${col}`;
          }
          if (update.docChanged) {
            docChanged = true;
            const text = update.state.doc.toString();
            // Parse frontmatter once per update cycle.
            // parseFrontmatter is fast (~0.5 µs); update the status bar
            // immediately so the char count never feels laggy.
            const { body } = parseFrontmatter(text);
            updateStatusCount(body);
            // Debounce the expensive marked.parse call so that rapid typing
            // (e.g. 10 keystrokes in 50 ms) triggers only one render instead
            // of ten.
            clearTimeout(previewTimer);
            previewTimer = setTimeout(() => renderPreview(text, output), 50);
          }
        }),
      ],
    });

    new EditorView({ state, parent: mount });
    // Initial render — synchronous on mount, no debounce needed.
    const { body: initialBody } = parseFrontmatter(initialDoc);
    renderPreview(initialDoc, output);
    updateStatusCount(initialBody);
  }

  // ── Mobile tab switching — APG Tabs pattern ──────────────────
  // Pane visibility is driven by aria-controls, not hardcoded IDs.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.editor-tab');
  const panes = [document.getElementById('editor-pane'), document.getElementById('preview-pane')];

  function activateTab(tab: HTMLButtonElement) {
    for (const t of tabs) {
      t.setAttribute('aria-selected', String(t === tab));
      t.tabIndex = t === tab ? 0 : -1;
    }
    const targetId = tab.getAttribute('aria-controls');
    for (const pane of panes) {
      pane?.classList.toggle('tab-active', pane.id === targetId);
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (e) => {
      const tabArr = [...tabs];
      const idx = tabArr.indexOf(tab);
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const nextIdx =
          e.key === 'ArrowRight'
            ? (idx + 1) % tabArr.length
            : (idx - 1 + tabArr.length) % tabArr.length;
        const next = tabArr[nextIdx];
        if (!next) return;
        next.focus();
        activateTab(next);
      }
    });
  }
</script>

<style>
  /* ── Root: full viewport, 3 rows (topbar / main / statusbar) ── */
  .editor-root {
    display: grid;
    grid-template-rows: 2.5rem 1fr 1.5rem; /* spec §4: 40px topbar / main / 24px statusbar */
    height: 100dvh;
    overflow: hidden;
    background: var(--editor-bg);
  }

  /* ── Top bar — spec §4: 40px ── */
  .editor-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    background: var(--editor-topbar-bg);
    border-bottom: 1px solid var(--editor-border);
    flex-shrink: 0;
    height: 2.5rem;
  }

  .editor-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem; /* 8px — grid aligned */
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
  }

  /* spec §4: L³ logo in amber */
  .editor-logo {
    color: var(--amber);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .editor-logo sup {
    font-size: 0.6em;
    vertical-align: super;
    line-height: 0;
  }

  .editor-bc-sep {
    /* SC 1.4.3: --editor-ink-2 gives 5.85:1 on --editor-topbar-bg */
    color: var(--editor-ink-2);
  }

  .editor-bc-file {
    /* SC 1.4.3: --editor-ink gives ~10:1 on --editor-topbar-bg */
    color: var(--editor-ink);
  }

  .editor-topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* spec §4: amber not on any button */
  .editor-btn {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    padding: 0.5rem 0.75rem; /* WCAG 2.5.8: touch target */
    background: transparent;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  /* Dark-context button colors — spec §4 role hierarchy:
     Discard (least prominent) → Publish (most prominent) */
  .editor-btn-discard {
    border: none;
    color: var(--editor-ink-2);
  }

  .editor-btn-discard:hover {
    color: var(--editor-ink);
  }

  /* spec §4: Publish — brightest ink, subtle border, NOT amber */
  .editor-btn-publish {
    border: 1px solid var(--editor-btn-border);
    border-radius: 2px;
    color: var(--editor-ink-bright);
  }

  .editor-btn-publish:hover {
    border-color: var(--editor-ink-2);
    color: var(--bg);
  }

  .editor-btn:active {
    opacity: 0.8;
  }

  .editor-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* ── Main: 50/50 split ── */
  .editor-main {
    display: grid;
    grid-template-columns: 1fr 1fr; /* spec §4: exactly 50/50 */
    overflow: hidden;
  }

  /* ── Editor pane (dark) — spec §4 ── */
  .editor-pane {
    display: flex;
    flex-direction: column;
    background: var(--editor-bg);
    border-right: 1px solid var(--editor-border);
    overflow: hidden;
  }

  .editor-body {
    flex: 1;
    overflow: hidden;
  }

  .editor-body :global(.cm-editor) {
    height: 100%;
    font-size: 0.875rem; /* comfortable for long-form writing */
  }

  .editor-body :global(.cm-scroller) {
    overflow: auto;
    font-family: var(--font-mono);
  }

  /* ── Preview pane (light) — spec §4: BG, padding 40px 48px ── */
  .preview-pane {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    overflow: hidden;
  }

  .preview-body {
    flex: 1;
    overflow-y: auto;
    padding: 2.5rem 3rem; /* spec §4 */
  }

  .preview-content {
    max-width: var(--measure);
  }

  .preview-placeholder {
    color: var(--ink-2); /* upgraded from Ink-3 for WCAG AA */
    font-style: italic;
    font-size: 0.9375rem;
  }

  /* ── Status bar — spec §4: 24px, amber never used ── */
  .editor-statusbar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 1rem;
    background: var(--editor-statusbar-bg);
    height: 1.5rem;
    flex-shrink: 0;
  }

  .status-item {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    color: var(--editor-ink-3);
    padding: 0 0.25rem;
    letter-spacing: 0.02em;
  }

  .status-sep {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    color: var(--editor-sep);
  }

  /* ── Editor tabs — hidden on desktop, visible on mobile ── */
  .editor-tabs {
    display: none;
  }

  .editor-tab {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.5rem 1rem;
    border: none;
    background: transparent;
    color: var(--editor-ink-2);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .editor-tab[aria-selected='true'] {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }

  /* ── Mobile: tab mode below 640px — spec §8 ── */
  @media (max-width: 639px) {
    .editor-tabs {
      display: flex;
      background: var(--editor-topbar-bg);
      border-bottom: 1px solid var(--editor-border);
    }

    .editor-root {
      grid-template-rows: 2.5rem auto 1fr 1.5rem;
    }

    .editor-main {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
    }

    .editor-pane {
      display: none;
      border-right: none;
    }

    .preview-pane {
      display: none;
    }

    .editor-pane.tab-active,
    .preview-pane.tab-active {
      display: flex;
    }
  }
</style>
