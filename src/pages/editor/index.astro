---
// No prerender — this is SSR-only
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/code.css';
---

<BaseLayout title="Editor — length3" description="Live MDX editor">
  <div class="editor-layout">
    <div class="editor-pane" aria-label="MDX source editor">
      <div class="editor-toolbar">
        <span class="editor-label">MDX</span>
      </div>
      <div class="cm-host" id="editor-mount"></div>
    </div>
    <div class="preview-pane" aria-label="Live preview" id="preview-pane">
      <div class="preview-toolbar">
        <span class="editor-label">Preview</span>
      </div>
      <div class="preview-content prose" id="preview-content">
        <p class="preview-placeholder">Start typing to see a preview…</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { EditorView, basicSetup } from 'codemirror';
  import { EditorState } from '@codemirror/state';
  import { markdown } from '@codemirror/lang-markdown';
  import { oneDark } from '@codemirror/theme-one-dark';

  const mount = document.getElementById('editor-mount');
  const preview = document.getElementById('preview-content');

  if (mount && preview) {
    const state = EditorState.create({
      doc: '# Hello\n\nStart writing MDX here.\n',
      extensions: [
        basicSetup,
        markdown(),
        oneDark,
        EditorView.updateListener.of((update) => {
          if (update.docChanged) {
            const text = update.state.doc.toString();
            // Naive preview: render headings and paragraphs
            preview.innerHTML = text
              .split('\n')
              .map((line) => {
                if (line.startsWith('# ')) return `<h1>${line.slice(2)}</h1>`;
                if (line.startsWith('## ')) return `<h2>${line.slice(3)}</h2>`;
                if (line.startsWith('### ')) return `<h3>${line.slice(4)}</h3>`;
                if (line.trim() === '') return '<br>';
                return `<p>${line}</p>`;
              })
              .join('');
          }
        }),
      ],
    });

    new EditorView({ state, parent: mount });
  }
</script>

<style>
  .editor-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100dvh;
    overflow: hidden;
  }

  .editor-pane {
    background: #1a1a2e;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .preview-pane {
    background: #fafaf8;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .editor-toolbar,
  .preview-toolbar {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .preview-toolbar {
    border-bottom: 1px solid var(--color-border);
    background: #fafaf8;
  }

  .editor-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.4);
  }

  .preview-toolbar .editor-label {
    color: var(--color-muted);
  }

  #editor-mount {
    flex: 1;
    overflow: hidden;
  }

  #editor-mount :global(.cm-editor) {
    height: 100%;
  }

  #editor-mount :global(.cm-scroller) {
    overflow: auto;
  }

  .preview-content {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
    max-width: none;
  }

  .preview-placeholder {
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 700px) {
    .editor-layout {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }
  }
</style>
