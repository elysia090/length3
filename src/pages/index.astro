---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getBlogIndex } from '../lib/blog-index';

const { processedPosts, topics } = await getBlogIndex();
---

<BaseLayout title="Length³" description="A technical blog.">
  <Header />
  <main class="index-layout" id="main-content">
    <section class="article-list" aria-label="Articles">
      {processedPosts.map((post) => <ArticleCard post={post} />)}
    </section>
    <div class="index-sidebar">
      <Sidebar topics={topics} />
    </div>
  </main>
  <Footer />
</BaseLayout>
