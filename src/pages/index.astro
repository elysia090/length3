---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ArchiveStage, ArticleList, TopicList } from '../features/archive';
import { SearchPanel } from '../features/search';
import { getBlogCatalog } from '../features/catalog';
import { RobotTuneStage } from '../features/robot-tune';
import { getSiteCopy } from '../i18n/site-copy';

const { processedPosts, topics, catalogNumbers, maxReadingTime } = await getBlogCatalog();
const copy = getSiteCopy('en');
---

<BaseLayout title="Length³" description="A technical blog.">
  <RobotTuneStage variant="opening" enter="#index" />
  <div id="index" class="index-anchor"></div>
  <Header />
  <main class="index-layout" id="main-content">
    <ArchiveStage posts={processedPosts} catalogNumbers={catalogNumbers} />
    <ArticleList
      posts={processedPosts}
      catalogNumbers={catalogNumbers}
      maxReadingTime={maxReadingTime}
    />
    <aside class="index-sidebar" aria-label={copy.blogSidebar}>
      <SearchPanel />
      <TopicList topics={topics} />
    </aside>
  </main>
  <Footer />
</BaseLayout>
