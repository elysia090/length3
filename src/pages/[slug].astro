---
export const prerender = true;

import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import type { BlogPost } from '../lib/types';
import { getBlogIndex } from '../lib/blog-index';
import { toSlug } from '../lib/utils';

export const getStaticPaths = (async () => {
  const { posts } = await getBlogIndex();
  return posts.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: BlogPost };
const { processedPostsById } = await getBlogIndex();
const { Content, headings } = await render(entry);
const processed = processedPostsById.get(entry.id);

if (!processed) {
  throw new Error(`Missing processed post for "${entry.id}".`);
}
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={processed.tags}
  readingTime={processed.readingTime}
  headings={headings}
  lang={entry.data.lang}
>
  <Content />
</ArticleLayout>
