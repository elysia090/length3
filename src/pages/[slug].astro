---
export const prerender = true;

import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { getBlogCatalog } from '../features/catalog';
import type { BlogPost, ProcessedPost } from '../features/catalog';

interface Reel {
  href: string;
  title: string;
  number: number;
}

export const getStaticPaths = (async () => {
  const { processedPosts, catalogNumbers } = await getBlogCatalog();
  // 新しい順に並んでいるので、一つ後ろが「前のリール」（古い記事）。
  const reel = (p: ProcessedPost | undefined): Reel | undefined =>
    p && {
      href: `/${p.slug}`,
      title: p.entry.data.title,
      number: catalogNumbers.get(p.slug) ?? 0,
    };
  return processedPosts.map((processed, i) => ({
    params: { slug: processed.slug },
    props: {
      entry: processed.entry,
      processed,
      number: catalogNumbers.get(processed.slug) ?? 0,
      previous: reel(processedPosts[i + 1]),
      next: reel(processedPosts[i - 1]),
    },
  }));
}) satisfies GetStaticPaths;

const { entry, processed, number, previous, next } = Astro.props as {
  entry: BlogPost;
  processed: ProcessedPost;
  number: number;
  previous?: Reel;
  next?: Reel;
};
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={processed.tags}
  readingTime={processed.readingTime}
  headings={headings}
  lang={entry.data.lang}
  number={number}
  previous={previous}
  next={next}
>
  <Content />
</ArticleLayout>
