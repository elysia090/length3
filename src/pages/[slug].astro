---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import type { BlogPost } from '../lib/types';
import { buildTagResolver, processPost, toSlug, notDraft } from '../lib/utils';

const allPosts = await getCollection('blog', notDraft);
const tagResolver = buildTagResolver(allPosts);

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', notDraft);
  return posts.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: BlogPost };
const { Content, headings } = await render(entry);
const processed = processPost(entry, tagResolver);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={processed.tags}
  readingTime={processed.readingTime}
  headings={headings}
  lang={entry.data.lang}
>
  <Content />
</ArticleLayout>
