---
export const prerender = true;

import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { getBlogCatalog } from '../lib/blog-data';
import type { BlogPost, ProcessedPost } from '../lib/types';

export const getStaticPaths = (async () => {
  const { processedPosts } = await getBlogCatalog();
  return processedPosts.map((processed) => ({
    params: { slug: processed.slug },
    props: { entry: processed.entry, processed },
  }));
}) satisfies GetStaticPaths;

const { entry, processed } = Astro.props as { entry: BlogPost; processed: ProcessedPost };
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={processed.tags}
  readingTime={processed.readingTime}
  headings={headings}
  lang={entry.data.lang}
>
  <Content />
</ArticleLayout>
