---
export const prerender = true;

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { Adam } from '../features/adam';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Length³" description="About Length³">
  <Header />
  <main class="about-shell" id="main-content">
    <header class="page-header about-header">
      <h1 class="page-title">About</h1>
      <hr class="amber-rule about-rule" />
    </header>
    <div class="about-body prose">
      <p>
        <strong>Length³</strong> is a technical blog focused on depth over breadth. Each article aims
        to be worth the time it takes to read.
      </p>
    </div>
    <div class="about-plate">
      <Adam />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 文章は短いので上に置き、絵はその下に版面の幅いっぱいで敷く。広い画面で
     2.39 : 1。狭い画面でも寄らずにほぼ全景を写すので 2 : 1（元絵は 2.2 : 1）。 */
  .about-shell {
    flex: 1;
    /* body が縦 flex なので、幅を宣言しないと margin-inline: auto が
       shrink-to-fit を招き、版面が内容の幅まで縮む。 */
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding-block: 2rem 4rem;
    padding-inline: max(var(--page-gutter), env(safe-area-inset-left))
      max(var(--page-gutter), env(safe-area-inset-right));
  }

  .about-rule {
    margin-top: 1rem;
  }

  .about-body {
    max-width: var(--measure);
  }

  .about-plate {
    aspect-ratio: 2 / 1;
    margin-top: 3rem;
  }

  @media (min-width: 52.5rem) {
    .about-shell {
      padding-block: 4rem 5rem;
    }

    .about-plate {
      aspect-ratio: 2.39 / 1;
      margin-top: 4rem;
    }
  }
</style>
