---
import '../styles/index.css';
import { getSiteCopy } from '../i18n/site-copy';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  publishDate?: Date;
  lang?: 'en' | 'ja';
}

const {
  title,
  description = 'A technical blog.',
  ogImage,
  ogType = 'website',
  publishDate,
  lang = 'en',
} = Astro.props;
const copy = getSiteCopy(lang);
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f9fa" />
    <!-- 石そのものを縮めた図。.ico に 16/32/48 の PNG を束ねてあるので、タブは
         それを引く。192 は Android のホーム画面、apple-touch は iOS で、
         こちらは角丸を OS が被せるぶん地色で埋めてある。 -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <!--
      一覧のタイルから記事へ、記事から一覧へ戻るときだけ、押したタイルが
      記事の見出しへ広がる（逆は縮んで帰る）。ほかのページ移動では何もしない。
      記事ページの見た目は変えない。トップの絵は持ち込まず、紙に切り替わるだけ。
      pagereveal は最初の描画の前に来るので、ここは head の中で同期で動く。
    -->
    <script is:inline>
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)');
        const path = (url) => (url ? new URL(url).pathname : '');
        const isIndex = (p) => p === '/';
        const isArticle = (p) => /^\/[^/]+$/.test(p) && !['/about', '/404'].includes(p);
        const tileFor = (p) =>
          document
            .querySelector(`.article-card .card-title a[href="${p}"]`)
            ?.closest('.article-card');
        const name = (card) => {
          if (!card) return false;
          card.style.viewTransitionName = 'lt-plate';
          const title = card.querySelector('.card-title');
          if (title) title.style.viewTransitionName = 'lt-title';
          return true;
        };
        const decide = (vt, from, to, card) => {
          if (!vt) return;
          const pair = (isIndex(from) && isArticle(to)) || (isArticle(from) && isIndex(to));
          if (reduced.matches || !pair || (card !== null && !name(card))) vt.skipTransition();
          else vt.types.add('tile');
        };
        addEventListener('pageswap', (e) => {
          const to = path(e.activation?.entry?.url);
          decide(
            e.viewTransition,
            location.pathname,
            to,
            isIndex(location.pathname) ? tileFor(to) : null,
          );
        });
        addEventListener('pagereveal', (e) => {
          const from = path(navigation?.activation?.from?.url);
          decide(
            e.viewTransition,
            from,
            location.pathname,
            isIndex(location.pathname) ? tileFor(from) : null,
          );
        });
      })();
    </script>
  </head>
  <body>
    <!-- SC 2.4.1: skip link — first focusable element, targets #main-content on each page -->
    <a href="#main-content" class="skip-link">{copy.skipToMainContent}</a>
    <slot />
  </body>
</html>
