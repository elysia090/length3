---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/typography.css';
import { getSiteCopy } from '../lib/ui-copy';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  publishDate?: Date;
  lang?: 'en' | 'ja';
}

const {
  title,
  description = 'A technical blog.',
  ogImage,
  ogType = 'website',
  publishDate,
  lang = 'en',
} = Astro.props;
const copy = getSiteCopy(lang);
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4eee5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  </head>
  <body>
    <!-- SC 2.4.1: skip link — first focusable element, targets #main-content on each page -->
    <a href="#main-content" class="skip-link">{copy.skipToMainContent}</a>
    <slot />
  </body>
</html>
