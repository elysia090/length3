---
import '../styles/index.css';
import { getSiteCopy } from '../i18n/site-copy';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  publishDate?: Date;
  lang?: 'en' | 'ja';
}

const {
  title,
  description = 'A technical blog.',
  ogImage,
  ogType = 'website',
  publishDate,
  lang = 'en',
} = Astro.props;
const copy = getSiteCopy(lang);
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7fb" />
    <!-- 石そのものを縮めた図。.ico に 16/32/48 の PNG を束ねてあるので、タブは
         それを引く。192 は Android のホーム画面、apple-touch は iOS で、
         こちらは角丸を OS が被せるぶん地色で埋めてある。 -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  </head>
  <body>
    <!-- SC 2.4.1: skip link — first focusable element, targets #main-content on each page -->
    <a href="#main-content" class="skip-link">{copy.skipToMainContent}</a>
    <slot />
  </body>
</html>
