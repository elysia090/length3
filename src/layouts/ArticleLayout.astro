---
import type { TocHeading } from '../lib/types';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleActions from '../components/ArticleActions.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatDate, tagToSlug } from '../lib/utils';
import '../styles/code.css';

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
  headings: TocHeading[];
  lang?: 'en' | 'ja';
  slug: string;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  tags,
  readingTime,
  headings,
  lang = 'en',
  slug,
} = Astro.props;

const dateStr = formatDate(publishDate, lang);
---

<BaseLayout title={title} description={description} lang={lang}>
  <Header />

  <Breadcrumb segments={[{ label: 'Length³', href: '/' }, { label: slug }]} />

  <!--
    Article shell: TOC | prose | empty right column
    spec §1: "The right column is deliberately empty — no widgets, no actions, no metadata."
  -->
  <div class="article-shell">
    <!-- TOC — left column, sticky -->
    <aside class="toc-aside" aria-label="Table of contents">
      <TableOfContents headings={headings} />
    </aside>

    <!-- Prose — center column -->
    <div class="prose-area">
      <article class="prose" data-pagefind-body lang={lang}>
        <header class="article-header">
          <div class="article-header-meta">
            <div class="article-header-tags">
              {
                tags.map((tag) => (
                  <a href={`/tags/${tagToSlug(tag)}`} class="article-header-tag">
                    #{tag}
                  </a>
                ))
              }
            </div>
            {tags.length > 0 && <span aria-hidden="true">·</span>}
            <time datetime={publishDate.toISOString()} class="article-header-date">
              {dateStr}
            </time>
            {
              updatedDate && (
                <span class="article-header-date">(upd. {formatDate(updatedDate, lang)})</span>
              )
            }
          </div>

          <h1>{title}</h1>
          <hr class="amber-rule article-header-hr" />

          {description && <p class="article-header-lead">{description}</p>}

          <p class="article-reading-time">{readingTime} min read</p>
        </header>

        <slot />
      </article>

      <!-- Actions at end of prose — relocated away from the article body per spec §1 -->
      <ArticleActions readingTime={readingTime} />
    </div>

    <!-- Right column: intentionally empty — spec §1 -->
    <div class="article-empty-margin" aria-hidden="true"></div>
  </div>

  <Footer />
</BaseLayout>
