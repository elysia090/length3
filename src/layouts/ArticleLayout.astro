---
import type { TagLink, TocHeading } from '../lib/types';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleActions from '../components/ArticleActions.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  updatedDate?: Date;
  tags: TagLink[];
  readingTime: number;
  headings: TocHeading[];
  lang?: 'en' | 'ja';
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  tags,
  readingTime,
  headings,
  lang = 'en',
} = Astro.props;

const dateStr = formatDate(publishDate, lang);
---

<BaseLayout title={title} description={description} lang={lang}>
  <Header />

  <!-- SC 2.4.1: id="main-content" is the skip-link target -->
  <main id="main-content">
    <!-- SC 2.4.6: breadcrumb uses article title (not URL slug) for a descriptive label -->
    <Breadcrumb segments={[{ label: 'Length³', href: '/' }, { label: title }]} />

    <!--
    Article shell: TOC | prose | empty right column
    spec §1: "The right column is deliberately empty — no widgets, no actions, no metadata."
  -->
    <div class="article-shell">
      <!-- TOC — left column, sticky -->
      <aside class="toc-aside" aria-label="Table of contents">
        <TableOfContents headings={headings} />
      </aside>

      <!-- Prose — center column -->
      <div class="prose-area">
        <article class="prose" data-pagefind-body lang={lang}>
          <header class="article-header">
            {
              tags.length > 0 && (
                <ul class="article-header-tags tag-pill-list" aria-label="Tags">
                  {tags.map((tag) => (
                    <li>
                      <a href={tag.href} class="article-header-tag tag-pill">
                        #{tag.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
            <div class="article-header-dates">
              <time datetime={publishDate.toISOString()} class="article-header-date">
                {dateStr}
              </time>
              {
                updatedDate && (
                  <span class="article-header-date">(upd. {formatDate(updatedDate, lang)})</span>
                )
              }
            </div>

            <h1>{title}</h1>
            <hr class="amber-rule article-header-hr" />

            {description && <p class="article-header-lead">{description}</p>}

            <p class="article-reading-time">{readingTime} min read</p>
          </header>

          <slot />
        </article>

        <!-- Actions at end of prose — relocated away from the article body per spec §1 -->
        <ArticleActions readingTime={readingTime} />
      </div>

      <!-- Right column: intentionally empty — spec §1 -->
      <div class="article-empty-margin" aria-hidden="true"></div>
    </div>
  </main>

  <Footer />
</BaseLayout>
