---
import type { TagLink, TocHeading } from '../lib/types';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleActions from '../components/ArticleActions.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import articlePageScript from '../scripts/article-page.ts?url&no-inline';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  updatedDate?: Date;
  tags: TagLink[];
  readingTime: number;
  headings: TocHeading[];
  lang?: 'en' | 'ja';
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  tags,
  readingTime,
  headings,
  lang = 'en',
} = Astro.props;

const dateStr = formatDate(publishDate, lang);
---

<BaseLayout title={title} description={description} lang={lang}>
  <Header />
  <main id="main-content">
    <Breadcrumb segments={[{ label: 'Length³', href: '/' }, { label: title }]} />
    <div class="article-shell">
      <aside class="toc-aside" aria-label="Table of contents">
        <TableOfContents headings={headings} />
      </aside>

      <div class="prose-area">
        <article class="prose" data-pagefind-body lang={lang}>
          <header class="article-header">
            {
              tags.length > 0 && (
                <ul class="article-header-tags tag-pill-list" aria-label="Tags">
                  {tags.map((tag) => (
                    <li>
                      <a href={tag.href} class="article-header-tag tag-pill">
                        #{tag.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
            <div class="article-header-dates">
              <time datetime={publishDate.toISOString()} class="article-header-date">
                {dateStr}
              </time>
              {
                updatedDate && (
                  <span class="article-header-date">(upd. {formatDate(updatedDate, lang)})</span>
                )
              }
            </div>

            <h1>{title}</h1>
            <hr class="amber-rule article-header-hr" />

            {description && <p class="article-header-lead">{description}</p>}

            <p class="article-reading-time">{readingTime} min read</p>
          </header>

          <slot />
        </article>

        <ArticleActions readingTime={readingTime} />
      </div>

      <div class="article-empty-margin" aria-hidden="true"></div>
    </div>
  </main>

  <Footer />
  <script is:inline type="module" src={articlePageScript}></script>
</BaseLayout>
