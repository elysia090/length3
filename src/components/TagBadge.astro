---
import { tagToSlug } from '../lib/utils';

interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<a href={`/tags/${tagToSlug(tag)}`} class="tag-badge" rel="tag">{tag}</a>

<style>
  .tag-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem; /* 4px 8px — grid aligned */
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-2);
    transition:
      border-color 80ms ease,
      color 80ms ease;
  }

  .tag-badge:hover,
  .tag-badge:active {
    color: var(--amber);
    border-color: var(--amber);
  }

  @media (pointer: coarse) {
    .tag-badge {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>
