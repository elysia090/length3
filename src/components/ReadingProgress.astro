---
// Thin progress bar — updated by ArticleActions.astro script
---

<div
  id="reading-progress"
  role="progressbar"
  aria-valuemin={0}
  aria-valuemax={100}
  aria-valuenow={0}
  aria-label="Reading progress"
>
</div>

<style>
  #reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: var(--progress, 0%);
    background: var(--amber);
    z-index: 200;
    transition: width 150ms linear;
    pointer-events: none;
  }
</style>
