---
import type { ProcessedPost } from '../types/blog';
import { formatDate } from '../lib/format-date';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const { entry, slug, readingTime, excerpt } = post;
const { title, publishDate, tags } = entry.data;

// Split date: year and MM.DD — spec §4
const year = publishDate.getFullYear().toString();
const mmdd = `${String(publishDate.getMonth() + 1).padStart(2, '0')}.${String(publishDate.getDate()).padStart(2, '0')}`;
---

<article class="article-card">
  <div class="card-date" aria-label={formatDate(publishDate)}>
    <span class="card-year">{year}</span>
    <span class="card-mmdd">{mmdd}</span>
  </div>
  <div class="card-body">
    {
      tags.length > 0 && (
        <div class="card-tags" aria-label="tags">
          {tags.map((t) => (
            <a href={`/tags/${t.toLowerCase()}`} class="card-tag">#{t}</a>
          ))}
        </div>
      )
    }
    <h2 class="card-title">
      <a href={`/${slug}`}>{title}</a>
    </h2>
    <p class="card-excerpt">{excerpt}</p>
    <div class="card-footer">
      <span class="card-reading-time">{readingTime} min</span>
    </div>
  </div>
</article>

<style>
  /* spec §4: 80px date column + 1fr content, 24px gap */
  .article-card {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 24px;
    padding: 32px 0;            /* bumped from 24px for more generous vertical rhythm */
    border-bottom: 1px solid var(--rule);
  }

  /* spec §4: first item padding-top: 0 */
  .article-card:first-child {
    padding-top: 0;
  }

  /* spec §4: last item no bottom border */
  .article-card:last-child {
    border-bottom: none;
  }

  /* spec §4: "2行を縦に並べ、間に明示的なgapなし" */
  .card-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 1.25rem;  /* align date block with title area */
    font-family: var(--font-mono);
    flex-shrink: 0;
    line-height: 1.3;     /* tight — year and MM.DD read as one block */
  }

  /* spec §4: year — Ink-2 (upgraded from Ink-3 for WCAG AA at 12px) */
  .card-year {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }

  /* spec §4: MM.DD — 0.8rem, Ink-2, letter-spacing 0.04em */
  .card-mmdd {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .card-body {
    min-width: 0;
  }

  /* spec §4: tags — amber, 0.75rem */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 8px;         /* bumped from 6px, aligns to 8px grid */
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--amber);
    transition: color 80ms ease;
  }

  .card-tag:hover {
    color: var(--ink);
  }

  /* spec §4 + §7: title — Fraunces, gravitational center of each card */
  .card-title {
    font-family: var(--font-display);
    font-size: 1.3125rem;       /* 21px — slightly larger for stronger gravity */
    font-weight: 500;           /* bumped from 400 for stronger visual gravity */
    line-height: 1.35;
    letter-spacing: -0.015em;   /* tighten to feel intentional at this weight */
    margin-bottom: 0.625rem;    /* 10px — breathing room before excerpt */
    text-wrap: balance;
  }

  /* spec §4: hover — title transitions to amber, 80ms ease */
  .card-title a {
    color: var(--ink);
    transition: color 80ms ease;
    cursor: default;
  }

  .card-title a:hover {
    color: var(--amber);
  }

  /* spec §4: description — 0.88rem, Ink-2, line-height 1.75, max 2 lines */
  .card-excerpt {
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--ink-2);
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* spec §4: reading time — Ink-2 (upgraded from Ink-3 for WCAG AA at 12px) */
  .card-reading-time {
    color: var(--ink-2);
  }
</style>
