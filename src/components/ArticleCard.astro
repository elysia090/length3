---
import type { ProcessedPost } from '../lib/types';
import { formatDate } from '../lib/utils';
import '../styles/article-card.css';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const { entry, slug, readingTime, description, tags: tagLinks } = post;
const { title, publishDate, lang } = entry.data;

const dateStr = formatDate(publishDate, lang);
---

<article class="article-card" lang={lang}>
  <div class="card-meta">
    <time datetime={publishDate.toISOString()} class="card-date">{dateStr}</time>
    {
      readingTime > 0 && (
        <>
          <span class="card-meta-sep" aria-hidden="true">
            —
          </span>
          <span class="card-reading-time">{readingTime} min</span>
        </>
      )
    }
  </div>
  <h2 class="card-title">
    <a href={`/${slug}`}>{title}</a>
  </h2>
  {description && <p class="card-excerpt">{description}</p>}
  {
    tagLinks.length > 0 && (
      <ul class="card-tags tag-pill-list" aria-label="Tags">
        {tagLinks.map((tag) => (
          <li>
            <a href={tag.href} class="card-tag tag-pill">
              #{tag.name}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
