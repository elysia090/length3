---
import type { ProcessedPost } from '../types/blog';
import TagBadge from './TagBadge.astro';
import { formatDate } from '../lib/format-date';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const { entry, slug, readingTime, excerpt } = post;
const { title, publishDate, tags } = entry.data;
---

<article class="article-card">
  <header class="card-header">
    <time datetime={publishDate.toISOString()} class="card-date">
      {formatDate(publishDate)}
    </time>
    {
      tags.length > 0 && (
        <ul class="card-tags" aria-label="tags">
          {tags.map((t) => (
            <li>
              <TagBadge tag={t} />
            </li>
          ))}
        </ul>
      )
    }
  </header>
  <h2 class="card-title">
    <a href={`/${slug}`}>{title}</a>
  </h2>
  <p class="card-excerpt">{excerpt}</p>
  <footer class="card-footer">
    <span class="card-reading-time">{readingTime} min read</span>
  </footer>
</article>

<style>
  .article-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .article-card:last-child {
    border-bottom: none;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .card-date {
    font-size: 0.875rem;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-excerpt {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .card-reading-time {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
