---
import type { ProcessedPost } from '../types/blog';
import { formatDate } from '../lib/format-date';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const { entry, slug, readingTime, excerpt } = post;
const { title, publishDate, tags } = entry.data;

// Split date into year and MM.DD
const year = publishDate.getFullYear().toString();
const mmdd = `${String(publishDate.getMonth() + 1).padStart(2, '0')}.${String(publishDate.getDate()).padStart(2, '0')}`;
---

<article class="article-card">
  <div class="card-date" aria-label={formatDate(publishDate)}>
    <span class="card-year">{year}</span>
    <span class="card-mmdd">{mmdd}</span>
  </div>
  <div class="card-body">
    {
      tags.length > 0 && (
        <div class="card-tags" aria-label="tags">
          {tags.map((t) => (
            <a href={`/tags/${t.toLowerCase()}`} class="card-tag">#{t}</a>
          ))}
        </div>
      )
    }
    <h2 class="card-title">
      <a href={`/${slug}`}>{title}</a>
    </h2>
    <p class="card-excerpt">{excerpt}</p>
    <div class="card-footer">
      <span class="card-reading-time">{readingTime} min</span>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .article-card:last-child {
    border-bottom: none;
  }

  .card-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .card-year {
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    opacity: 0.75;
  }

  .card-mmdd {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .card-body {
    min-width: 0;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-tag);
    transition: color 0.1s;
  }

  .card-tag:hover {
    color: var(--color-accent);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-bottom: 0.6rem;
    font-feature-settings: 'palt';
  }

  .card-title a {
    color: var(--color-text);
    transition: color 0.1s;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-excerpt {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .card-footer {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
    display: flex;
    gap: 1rem;
  }
</style>
