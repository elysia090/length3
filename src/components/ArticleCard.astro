---
import type { ProcessedPost } from '../lib/types';
import { formatDate } from '../lib/utils';
import { formatCompactReadingTime, getSiteCopy } from '../lib/ui-copy';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const { entry, slug, readingTime, description, tags: tagLinks } = post;
const { title, publishDate, lang } = entry.data;

const dateStr = formatDate(publishDate, lang);
const visibleTagLinks = tagLinks.slice(0, 4);
const hiddenTagCount = Math.max(0, tagLinks.length - visibleTagLinks.length);
const copy = getSiteCopy(lang);
---

<!-- SC 3.1.2: lang attr ensures AT uses correct phonetic rules for card language -->
<article class="article-card" lang={lang}>
  <div class="card-meta">
    <time datetime={publishDate.toISOString()} class="card-date">{dateStr}</time>
    {
      readingTime > 0 && (
        <>
          <span class="card-meta-sep" aria-hidden="true">
            —
          </span>
          <span class="card-reading-time">{formatCompactReadingTime(readingTime, lang)}</span>
        </>
      )
    }
  </div>
  <h2 class="card-title">
    <a href={`/${slug}`}>{title}</a>
  </h2>
  {description && <p class="card-excerpt">{description}</p>}
  {
    visibleTagLinks.length > 0 && (
      <ul class="card-tags tag-pill-list" aria-label={copy.tags}>
        {visibleTagLinks.map((tag) => (
          <li>
            <a href={tag.href} class="tag-pill">
              #{tag.name}
            </a>
          </li>
        ))}
        {hiddenTagCount > 0 && (
          <li>
            <span class="tag-pill tag-pill-overflow">
              +{hiddenTagCount}
            </span>
          </li>
        )}
      </ul>
    )
  }
</article>

<style>
  /* Single-column card: date → title → description → tags */
  .article-card {
    padding: 1.75rem 0;
    border-bottom: 0.0625rem solid var(--rule);
  }

  .article-card:first-child {
    padding-top: 0;
  }

  .article-card:last-child {
    border-bottom: none;
  }

  /* Date + reading time — inline, top of card */
  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    letter-spacing: 0.08em;
    margin-bottom: 0.375rem;
  }

  .card-date {
    color: var(--amber-text); /* SC 1.4.3: 4.73:1 on --bg */
    min-width: 9.5ch;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .card-meta-sep {
    color: var(--ink-2); /* upgraded from Ink-3 for WCAG AA at 12px */
  }

  .card-reading-time {
    color: var(--ink-2);
  }

  /* Title — gravitational center, heaviest element */
  .card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400; /* spec §4 */
    line-height: 1.32;
    letter-spacing: -0.015em;
    margin-bottom: 0.625rem;
    text-wrap: balance;
  }

  .card-title a {
    color: var(--ink);
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--amber-text);
  }

  /* Description — secondary, below title */
  .card-excerpt {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--ink-2);
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags — global .tag-pill が基底。カード固有の上書きのみここで定義 */
  .card-tags {
    margin: 0;
  }

  @media (min-width: 40rem) {
    .article-card {
      padding: 2rem 0;
    }

    .card-title {
      font-size: 1.25rem;
    }
  }
</style>
