---

---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-brand">Length<sup class="footer-sup">3</sup></span>
    <span class="footer-sep" aria-hidden="true">—</span>
    <span class="footer-copy">&copy; {new Date().getFullYear()}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 0.0625rem solid var(--rule);
    margin-top: auto;
    background-image: linear-gradient(180deg, rgba(249, 248, 245, 0.94), rgba(240, 237, 232, 0.96));
  }

  .footer-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding-block: 1rem;
    padding-inline: max(var(--page-gutter), env(safe-area-inset-left))
      max(var(--page-gutter), env(safe-area-inset-right));
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    color: var(--ink-2);
  }

  .footer-sup {
    display: inline-block;
    background: linear-gradient(
      180deg,
      var(--agate-soft) 0%,
      var(--agate-core) 52%,
      var(--amber-deep) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 0.6em;
    vertical-align: super;
    /* line-height:0 collapsed the inline-block to zero height, making
       background-clip:text paint nothing and the "3" invisible. */
    line-height: 1;
  }

  @media (forced-colors: active) {
    .footer-sup {
      background: none;
      -webkit-background-clip: border-box;
      background-clip: border-box;
      color: currentColor;
    }
  }

  .footer-sep {
    color: var(--rule);
  }
</style>
