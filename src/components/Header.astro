---
// No props
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-title" aria-label="Length³ home">
      Length<sup class="site-title-sup">3</sup>
    </a>
    <nav class="header-nav" aria-label="primary">
      <a href="/">(Articles)</a>
      <a href="/tags">(Tags)</a>
      <a href="/about">(About)</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--bg);
    /* spec §4: position static — scrolls away with page */
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 1.5rem;   /* spec §4: 20px top and bottom */
  }

  .site-title {
    font-family: var(--font-mono);
    font-size: 0.88rem;   /* spec §4 */
    font-weight: 400;
    color: var(--ink);
  }

  .site-title-sup {
    color: var(--amber);   /* spec §4: ³ is amber */
    font-size: 0.6em;
    vertical-align: super;
    line-height: 0;
  }

  .site-title:hover {
    color: var(--amber);
  }

  .header-nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;   /* spec §4 */
    color: var(--ink-2);
  }

  /* spec §4: hover transitions text inside parens to Ink, no underline */
  .header-nav a {
    padding: 1rem 0;              /* WCAG 2.5.8: 44px touch target */
    transition: color 80ms ease;
  }

  .header-nav a:hover {
    color: var(--ink);
    /* no text-decoration — spec §4 */
  }
</style>
