---
// No props
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-title">length3</a>
    <nav class="header-nav" aria-label="Site navigation">
      <a href="/">Articles</a>
      <a href="/tags">Tags</a>
      <a href="/editor">Editor</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }

  .site-title:hover {
    color: var(--color-accent);
  }

  .header-nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .header-nav a:hover {
    color: var(--color-text);
  }
</style>
