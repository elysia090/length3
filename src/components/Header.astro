---
import { getSiteCopy } from '../i18n/site-copy';

interface Props {
  lang?: 'en' | 'ja';
}

const { pathname } = Astro.url;
const { lang = 'en' } = Astro.props;
const copy = getSiteCopy(lang);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-title">
      <span>Length<sup class="site-title-sup">3</sup></span>
    </a>
    <nav class="header-nav" aria-label={copy.navigation}>
      <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>({copy.articles})</a>
      <a href="/about" aria-current={pathname === '/about' ? 'page' : undefined}>({copy.about})</a>
    </nav>
  </div>
</header>
