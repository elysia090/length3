---
import '../styles/breadcrumb.css';

interface Segment {
  label: string;
  href?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {
      segments.map((seg, i) => (
        <li>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              /
            </span>
          )}
          {seg.href ? (
            <a href={seg.href} class="crumb">
              {seg.label}
            </a>
          ) : (
            <span class="crumb crumb-current" aria-current="page">
              {seg.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
