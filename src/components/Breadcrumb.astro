---
interface Segment {
  label: string;
  href?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {
      segments.map((seg, i) => (
        <li>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              /
            </span>
          )}
          {seg.href ? (
            <a href={seg.href} class="crumb">
              {seg.label}
            </a>
          ) : (
            <span class="crumb crumb-current" aria-current="page">
              {seg.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding-top: 0.75rem;
    padding-inline: max(var(--page-gutter), env(safe-area-inset-left))
      max(var(--page-gutter), env(safe-area-inset-right));
    text-align: center;
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: 0.5rem; /* 8px — grid aligned */
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sep {
    color: var(--rule);
  }

  .crumb {
    color: var(--ink-2);
    transition: color var(--transition-fast);
  }

  a.crumb:hover,
  a.crumb:active {
    color: var(--amber);
  }

  .crumb-current {
    color: var(--ink);
  }

  @media (min-width: 40rem) {
    .breadcrumb {
      padding-top: 1rem;
      text-align: left;
    }

    .breadcrumb ol {
      justify-content: flex-start;
    }
  }
</style>
