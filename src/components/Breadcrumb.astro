---
import { getSiteCopy } from '../i18n/site-copy';

interface Segment {
  label: string;
  href?: string;
}

interface Props {
  flush?: boolean;
  lang?: 'en' | 'ja';
  /** Align to the --measure column instead of the 1200px outer container. */
  measure?: boolean;
  segments: Segment[];
}

const { segments, flush = false, measure = false, lang = 'en' } = Astro.props;
const copy = getSiteCopy(lang);
---

<nav
  class:list={['breadcrumb', { 'breadcrumb--flush': flush, 'breadcrumb--measure': measure }]}
  aria-label={copy.breadcrumb}
>
  <ol>
    {
      segments.map((seg, i) => (
        <li>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              /
            </span>
          )}
          {seg.href ? (
            <a href={seg.href} class="crumb crumb-link">
              {seg.label}
            </a>
          ) : (
            <span class="crumb crumb-current" aria-current="page">
              {seg.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
