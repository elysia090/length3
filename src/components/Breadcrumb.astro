---
interface Segment {
  label: string;
  href?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  {
    segments.map((seg, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        {seg.href ? (
          <a href={seg.href} class="crumb">{seg.label}</a>
        ) : (
          <span class="crumb crumb-current" aria-current="page">{seg.label}</span>
        )}
      </>
    ))
  }
</nav>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem 0;
  }

  .sep {
    color: var(--rule);
  }

  .crumb {
    color: var(--ink-2);
    transition: color 80ms ease;
  }

  a.crumb:hover {
    color: var(--amber);
  }

  .crumb-current {
    color: var(--ink);
  }
</style>
