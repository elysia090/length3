---
interface Props {
  readingTime: number;
}

const { readingTime } = Astro.props;
---

<!--
  Reading progress bar lives here (position: fixed — DOM location is irrelevant).
  Previously in ReadingProgress.astro, but that split one feature across two files
  with the controlling script always living here. Merged per KISS.
-->
<div
  id="reading-progress"
  role="progressbar"
  aria-valuemin={0}
  aria-valuemax={100}
  aria-valuenow={0}
  aria-label="Reading progress"
>
</div>

<div class="article-actions" data-reading-time={readingTime}>
  <div class="actions-group">
    <button class="action-row" id="copy-link-btn" aria-label="Copy link to clipboard">
      <span class="action-dash" aria-hidden="true">—</span>
      <span class="action-label">Copy link</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
    <button class="action-row" id="share-btn" aria-label="Share article">
      <span class="action-dash" aria-hidden="true">×</span>
      <span class="action-label">Share</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
  </div>
  <p id="article-action-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

  <!-- aria-live removed: role="progressbar" on #reading-progress already handles AT updates.
       Polling aria-live on every scroll causes disruptive double-announcements (H1/Nielsen). -->
  <div class="reading-stats" aria-label="Reading progress stats">
    <div class="stat-row">
      <span class="stat-pct" id="pct-read">0%</span>
      <span class="stat-detail">read</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail" id="min-left">—</span>
      <span class="stat-detail">left</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail">{readingTime} min</span>
      <span class="stat-detail">total</span>
    </div>
  </div>
</div>

<script>
  const container = document.querySelector<HTMLElement>('.article-actions');
  const statusEl = document.getElementById('article-action-status');
  const rt = Number(container?.dataset.readingTime) || 5;

  /** Temporarily swap an element's text, then restore it after `ms` milliseconds. */
  function flash(selector: string, tempText: string, restoreText: string, ms = 1500) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) return;
    el.textContent = tempText;
    setTimeout(() => {
      el.textContent = restoreText;
    }, ms);
  }

  function announce(message: string) {
    if (!statusEl) return;
    statusEl.textContent = '';
    requestAnimationFrame(() => {
      if (statusEl) statusEl.textContent = message;
    });
  }

  // Copy link
  document.getElementById('copy-link-btn')?.addEventListener('click', () => {
    navigator.clipboard
      .writeText(window.location.href)
      .then(() => {
        flash('#copy-link-btn .action-label', 'Copied!', 'Copy link');
        announce('Link copied to clipboard.');
      })
      .catch((err) => {
        console.warn('[copy-link] clipboard write failed:', err);
        flash('#copy-link-btn .action-label', 'Failed', 'Copy link');
        announce('Could not copy the link. Copy the URL from the address bar.');
      });
  });

  // Share (native sheet when available, clipboard fallback otherwise)
  document.getElementById('share-btn')?.addEventListener('click', () => {
    if (navigator.share) {
      // AbortError = user dismissed the share sheet; not a real error, suppress it.
      navigator
        .share({ url: window.location.href, title: document.title })
        .then(() => {
          announce('Share dialog completed.');
        })
        .catch((err) => {
          if (err instanceof Error && err.name !== 'AbortError') {
            console.warn('[share] navigator.share failed:', err);
            flash('#share-btn .action-label', 'Failed', 'Share');
            announce('Could not share the article. Try copying the URL instead.');
          }
        });
    } else {
      navigator.clipboard
        .writeText(window.location.href)
        .then(() => {
          flash('#share-btn .action-label', 'Copied!', 'Share');
          announce('Link copied to clipboard.');
        })
        .catch((err) => {
          console.warn('[share] clipboard fallback failed:', err);
          flash('#share-btn .action-label', 'Failed', 'Share');
          announce('Could not share the article. Try copying the URL instead.');
        });
    }
  });

  // Reading progress stats + bar
  function updateStats() {
    const scrolled = window.scrollY;
    const total = document.body.scrollHeight - window.innerHeight;
    const pct = total > 0 ? Math.min(100, Math.round((scrolled / total) * 100)) : 0;
    const minsLeft = Math.max(0, Math.round(rt * (1 - pct / 100)));

    const pctEl = document.getElementById('pct-read');
    const minEl = document.getElementById('min-left');
    if (pctEl) pctEl.textContent = `${pct}%`;
    if (minEl) minEl.textContent = minsLeft > 0 ? `~${minsLeft} min` : '< 1 min';

    const bar = document.getElementById('reading-progress');
    if (bar) {
      bar.style.setProperty('--progress', `${pct}%`);
      bar.setAttribute('aria-valuenow', String(pct));
    }
  }

  // rAF throttle: coalesce multiple scroll events per frame into one DOM write.
  let rafId: number | undefined;
  window.addEventListener(
    'scroll',
    () => {
      if (rafId !== undefined) return;
      rafId = requestAnimationFrame(() => {
        updateStats();
        rafId = undefined;
      });
    },
    { passive: true },
  );
  updateStats();
</script>

<style>
  /* Reading progress bar — position: fixed so DOM location is irrelevant */
  #reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: var(--progress, 0%);
    background: var(--amber);
    /* SC 2.4.11: lowered from 200 so it cannot obscure focus rings of interactive elements */
    z-index: 10;
    transition: width 150ms linear;
    pointer-events: none;
  }

  .article-actions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .actions-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem; /* 4px — grid aligned */
  }

  .action-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 0; /* WCAG 2.5.8: 2×1rem padding + line-height ≥ 2.75rem total */
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    text-align: left;
    width: 100%;
    transition: color var(--transition-fast);
  }

  .action-row:hover,
  .action-row:active {
    color: var(--ink);
  }

  .action-row:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .action-dash {
    width: 1rem;
    flex-shrink: 0;
    color: var(--amber);
    font-weight: 600;
  }

  .action-label {
    flex: 1;
  }

  .action-arrow {
    color: var(--rule);
    font-size: 1rem;
  }

  .reading-stats {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-row {
    display: flex;
    gap: 0.25rem; /* 4px — grid aligned */
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    color: var(--ink-2);
    align-items: baseline;
  }

  .stat-pct {
    font-size: 0.8125rem; /* reduced from 0.875rem to match quiet design */
    color: var(--ink);
    font-weight: 400; /* reduced from 500 for proportional weight */
    min-width: 2.5rem;
  }

  .stat-detail {
    color: var(--ink-2);
  } /* upgraded from Ink-3 for WCAG AA */
</style>
