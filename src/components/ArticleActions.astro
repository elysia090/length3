---
interface Props {
  readingTime: number;
}

const { readingTime } = Astro.props;
---

<!--
  Reading progress bar lives here (position: fixed — DOM location is irrelevant).
  Previously in ReadingProgress.astro, but that split one feature across two files
  with the controlling script always living here. Merged per KISS.
-->
<div
  id="reading-progress"
  role="progressbar"
  aria-valuemin={0}
  aria-valuemax={100}
  aria-valuenow={0}
  aria-label="Reading progress"
>
</div>

<div class="article-actions" data-reading-time={readingTime}>
  <div class="actions-group">
    <button class="action-row" id="copy-link-btn" aria-label="Copy link to clipboard">
      <span class="action-dash" aria-hidden="true">—</span>
      <span class="action-label">Copy link</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
    <button class="action-row" id="share-btn" aria-label="Share article">
      <span class="action-dash" aria-hidden="true">×</span>
      <span class="action-label">Share</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
  </div>
  <p id="article-action-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

  <!-- aria-live removed: role="progressbar" on #reading-progress already handles AT updates.
       Polling aria-live on every scroll causes disruptive double-announcements (H1/Nielsen). -->
  <div class="reading-stats" aria-label="Reading progress stats">
    <div class="stat-row">
      <span class="stat-pct" id="pct-read">0%</span>
      <span class="stat-detail">read</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail" id="min-left">—</span>
      <span class="stat-detail">left</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail">{readingTime} min</span>
      <span class="stat-detail">total</span>
    </div>
  </div>
</div>

<script>
  import { createArticleActionsController } from '../lib/article-actions';

  const container = document.querySelector<HTMLElement>('.article-actions');
  const status = document.getElementById('article-action-status');
  const copyButton = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
  const shareButton = document.getElementById('share-btn') as HTMLButtonElement | null;
  const percentRead = document.getElementById('pct-read');
  const minutesLeft = document.getElementById('min-left');
  const progressBar = document.getElementById('reading-progress');
  const copyLabel = copyButton?.querySelector<HTMLElement>('.action-label') ?? null;
  const shareLabel = shareButton?.querySelector<HTMLElement>('.action-label') ?? null;

  if (
    container &&
    status &&
    copyButton &&
    shareButton &&
    copyLabel &&
    shareLabel &&
    percentRead &&
    minutesLeft &&
    progressBar
  ) {
    createArticleActionsController(
      {
        elements: {
          copyButton,
          copyLabel,
          minutesLeft,
          percentRead,
          progressBar,
          shareButton,
          shareLabel,
          status,
        },
        readingTime: Number(container.dataset.readingTime) || 5,
      },
      {
        addScrollListener: (listener) => {
          window.addEventListener('scroll', listener, { passive: true });
          return () => window.removeEventListener('scroll', listener);
        },
        clipboardWriteText: (text) => {
          const writeText = navigator.clipboard?.writeText?.bind(navigator.clipboard);
          return writeText
            ? writeText(text)
            : Promise.reject(new Error('Clipboard API unavailable.'));
        },
        getDocumentTitle: () => document.title,
        getLocationHref: () => window.location.href,
        getScrollMetrics: () => ({
          scrollHeight: document.body.scrollHeight,
          scrollY: window.scrollY,
          viewportHeight: window.innerHeight,
        }),
        requestFrame: (callback) => window.requestAnimationFrame(() => callback()),
        setTimeout: (callback, ms) => window.setTimeout(callback, ms),
        share: navigator.share
          ? (data) => navigator.share!({ title: data.title, url: data.url })
          : null,
        warn: (scope, error) => console.warn(`[${scope}]`, error),
      },
    );
  }
</script>

<style>
  /* Reading progress bar — position: fixed so DOM location is irrelevant */
  #reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: var(--progress, 0%);
    background: var(--amber);
    /* SC 2.4.11: lowered from 200 so it cannot obscure focus rings of interactive elements */
    z-index: 10;
    transition: width 150ms linear;
    pointer-events: none;
  }

  .article-actions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .actions-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem; /* 4px — grid aligned */
  }

  .action-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 0; /* WCAG 2.5.8: 2×1rem padding + line-height ≥ 2.75rem total */
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    text-align: left;
    width: 100%;
    transition: color var(--transition-fast);
  }

  .action-row:hover,
  .action-row:active {
    color: var(--ink);
  }

  .action-row:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .action-dash {
    width: 1rem;
    flex-shrink: 0;
    color: var(--amber);
    font-weight: 600;
  }

  .action-label {
    flex: 1;
  }

  .action-arrow {
    color: var(--rule);
    font-size: 1rem;
  }

  .reading-stats {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-row {
    display: flex;
    gap: 0.25rem; /* 4px — grid aligned */
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    color: var(--ink-2);
    align-items: baseline;
  }

  .stat-pct {
    font-size: 0.8125rem; /* reduced from 0.875rem to match quiet design */
    color: var(--ink);
    font-weight: 400; /* reduced from 500 for proportional weight */
    min-width: 2.5rem;
  }

  .stat-detail {
    color: var(--ink-2);
  } /* upgraded from Ink-3 for WCAG AA */
</style>
