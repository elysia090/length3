---
import { formatCompactReadingTime, getSiteCopy } from '../lib/ui-copy';

interface Props {
  lang?: 'en' | 'ja';
  readingTime: number;
}

const { readingTime, lang = 'en' } = Astro.props;
const copy = getSiteCopy(lang);
---

<!--
  Reading progress bar lives here (position: fixed — DOM location is irrelevant).
  Previously in ReadingProgress.astro, but that split one feature across two files
  with the controlling script always living here. Merged per KISS.
-->
<div
  id="reading-progress"
  role="progressbar"
  aria-valuemin={0}
  aria-valuemax={100}
  aria-valuenow={0}
  aria-label={copy.readingProgress}
>
</div>

<div class="article-actions" data-lang={lang} data-reading-time={readingTime}>
  <div class="actions-group">
    <button class="action-row" id="copy-link-btn" aria-label={copy.copyLinkAria}>
      <span class="action-dash" aria-hidden="true">—</span>
      <span class="action-label">{copy.copyLink}</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
    <button class="action-row" id="share-btn" aria-label={copy.shareAria}>
      <span class="action-dash" aria-hidden="true">×</span>
      <span class="action-label">{copy.share}</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
  </div>
  <p id="article-action-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

  <!-- aria-live removed: role="progressbar" on #reading-progress already handles AT updates.
       Polling aria-live on every scroll causes disruptive double-announcements (H1/Nielsen). -->
  <div class="reading-stats" aria-label={copy.readingProgressStats}>
    <div class="stat-row">
      <span class="stat-pct" id="pct-read">0%</span>
      <span class="stat-detail">{copy.read}</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail" id="min-left">—</span>
      <span class="stat-detail">{copy.left}</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail">{formatCompactReadingTime(readingTime, lang)}</span>
      <span class="stat-detail">{copy.total}</span>
    </div>
  </div>
</div>

<script>
  import { initializeArticleActions } from '../lib/article-actions';

  initializeArticleActions();
</script>

<style>
  /* Reading progress bar — position: fixed so DOM location is irrelevant */
  #reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 0.125rem;
    width: var(--progress, 0%);
    background: var(--amber-deep);
    /* SC 2.4.11: lowered from 200 so it cannot obscure focus rings of interactive elements */
    z-index: 10;
    transition: width 150ms linear;
    pointer-events: none;
  }

  .article-actions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 0.0625rem solid var(--rule);
  }

  .actions-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem; /* 4px — grid aligned */
  }

  .action-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 0; /* WCAG 2.5.8: 2×1rem padding + line-height ≥ 2.75rem total */
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    text-align: left;
    width: 100%;
    transition: color var(--transition-fast);
  }

  .action-row:hover,
  .action-row:active {
    color: var(--ink);
  }

  .action-row:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .action-dash {
    width: 1rem;
    flex-shrink: 0;
    color: var(--amber-text);
    font-weight: 600;
  }

  .action-label {
    flex: 1;
  }

  .action-arrow {
    color: var(--rule);
    font-size: 1rem;
  }

  .reading-stats {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-row {
    display: flex;
    gap: 0.25rem; /* 4px — grid aligned */
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    color: var(--ink-2);
    align-items: baseline;
  }

  .stat-pct {
    font-size: 0.8125rem; /* reduced from 0.875rem to match quiet design */
    color: var(--ink);
    font-weight: 400; /* reduced from 500 for proportional weight */
    min-width: 2.5rem;
  }

  .stat-detail {
    color: var(--ink-2);
  } /* upgraded from Ink-3 for WCAG AA */
</style>
