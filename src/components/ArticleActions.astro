---
import { formatCompactReadingTime, getSiteCopy } from '../lib/ui-copy';

interface Props {
  lang?: 'en' | 'ja';
  readingTime: number;
  title: string;
}

const { readingTime, lang = 'en', title } = Astro.props;
const copy = getSiteCopy(lang);
---

<!--
  Reading progress bar lives here (position: fixed — DOM location is irrelevant).
  Previously in ReadingProgress.astro, but that split one feature across two files
  with the controlling script always living here. Merged per KISS.
-->
<div
  id="reading-progress"
  role="progressbar"
  aria-valuemin={0}
  aria-valuemax={100}
  aria-valuenow={0}
  aria-label={copy.readingProgress}
>
</div>

<div class="article-actions" data-lang={lang} data-reading-time={readingTime} data-title={title}>
  <div class="actions-group">
    <button class="action-row" id="copy-link-btn" aria-label={copy.copyLinkAria}>
      <span class="action-dash" aria-hidden="true">—</span>
      <span class="action-label">{copy.copyLink}</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
    <button class="action-row" id="share-btn" aria-label={copy.shareAria}>
      <span class="action-dash" aria-hidden="true">×</span>
      <span class="action-label">{copy.share}</span>
      <span class="action-arrow" aria-hidden="true">&rsaquo;</span>
    </button>
  </div>
  <p id="article-action-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

  <!-- aria-live removed: role="progressbar" on #reading-progress already handles AT updates.
       Polling aria-live on every scroll causes disruptive double-announcements (H1/Nielsen). -->
  <div class="reading-stats" aria-label={copy.readingProgressStats}>
    <div class="stat-row">
      <span class="stat-pct" id="pct-read">0%</span>
      <span class="stat-detail">{copy.read}</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail" id="min-left">—</span>
      <span class="stat-detail">{copy.left}</span>
    </div>
    <div class="stat-row">
      <span class="stat-detail">{formatCompactReadingTime(readingTime, lang)}</span>
      <span class="stat-detail">{copy.total}</span>
    </div>
  </div>
</div>

<script>
  import { initializeArticleActions } from '../lib/article-actions';

  initializeArticleActions();
</script>
