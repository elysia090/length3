---
interface TopicSummary {
  count: number;
  href: string;
  name: string;
}

interface Props {
  topics: TopicSummary[];
}

const { topics } = Astro.props;
---

<aside class="sidebar" aria-label="Blog sidebar">
  <div class="search-input-wrap">
    <button
      id="search-trigger"
      class="search-underline-btn"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="search-modal"
    >
      <span class="search-icon" aria-hidden="true">Q</span>
      <span class="search-placeholder">Search articles…</span>
      <kbd class="search-shortcut" aria-label="keyboard shortcut: slash">/</kbd>
    </button>
  </div>
  {
    topics.length > 0 && (
      <section class="sidebar-topics" aria-labelledby="sidebar-topics-heading">
        <h2 class="sidebar-heading" id="sidebar-topics-heading">
          Topics
        </h2>
        <ul class="sidebar-topic-list">
          {topics.map((topic) => (
            <li>
              <a href={topic.href} class="sidebar-topic-card" rel="tag">
                <span class="sidebar-topic-name">#{topic.name}</span>
                <span class="sidebar-topic-count">{topic.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</aside>

<!-- Search modal — spec §4 — native <dialog> for built-in focus trap, Escape, and backdrop -->
<dialog id="search-modal" class="search-overlay" aria-label="Search">
  <div class="search-card">
    <div class="search-input-row">
      <span class="search-q" aria-hidden="true">Q</span>
      <input
        id="pagefind-input"
        type="search"
        class="search-field"
        name="search"
        placeholder="Search articles…"
        autocomplete="off"
        aria-label="Search articles"
      />
      <button class="search-esc-btn" id="search-close" aria-label="Close search">esc</button>
    </div>
    <p id="search-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    <div
      id="pagefind-results"
      class="search-results"
      role="region"
      aria-label="Search results"
      aria-busy="false"
    >
    </div>
    <div class="search-footer" aria-hidden="true">
      <span class="search-hint">↑↓ navigate</span>
      <span class="search-hint">↵ open</span>
      <span class="search-hint">esc close</span>
      <span class="search-powered">Pagefind</span>
    </div>
  </div>
</dialog>

<script>
  const trigger = document.getElementById('search-trigger') as HTMLButtonElement | null;
  const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
  const results = document.getElementById('pagefind-results') as HTMLDivElement | null;
  const status = document.getElementById('search-status') as HTMLParagraphElement | null;
  let initialized = false;
  let statusObserver: MutationObserver | null = null;
  let statusFrame = 0;
  let lastStatus = '';

  function setSearchStatus(message: string) {
    if (!status) return;
    const next = message.trim();
    if (next === lastStatus) return;
    status.textContent = next;
    lastStatus = next;
  }

  function summarizeSearchResults() {
    if (!results) return '';

    const loading = results.querySelector<HTMLElement>('.search-loading')?.textContent?.trim();
    if (loading) return loading;

    const unavailable = results
      .querySelector<HTMLElement>('.search-unavailable')
      ?.textContent?.trim();
    if (unavailable) return unavailable;

    const resultCount = results.querySelectorAll('.pagefind-ui__result').length;
    if (resultCount > 0) {
      return `${resultCount} search result${resultCount === 1 ? '' : 's'} available.`;
    }

    const message = results
      .querySelector<HTMLElement>(
        '.pagefind-ui__message, .pagefind-ui__results-message, .pagefind-ui__result-message',
      )
      ?.textContent?.trim();
    return message ?? '';
  }

  function syncSearchStatus() {
    setSearchStatus(summarizeSearchResults());
  }

  function scheduleStatusSync() {
    if (statusFrame) cancelAnimationFrame(statusFrame);
    statusFrame = requestAnimationFrame(() => {
      statusFrame = 0;
      syncSearchStatus();
    });
  }

  function observeSearchStatus() {
    if (!results || statusObserver) return;

    statusObserver = new MutationObserver(() => {
      scheduleStatusSync();
    });
    statusObserver.observe(results, {
      childList: true,
      subtree: true,
      characterData: true,
      attributes: true,
    });
  }

  function setResultsBusy(isBusy: boolean) {
    results?.setAttribute('aria-busy', String(isBusy));
  }

  function resetSearchStatus() {
    lastStatus = '';
    if (status) status.textContent = '';
  }

  async function initSearch() {
    if (initialized) return;
    initialized = true;
    observeSearchStatus();
    setResultsBusy(true);
    if (results) results.innerHTML = '<p class="search-loading">Loading…</p>';
    syncSearchStatus();
    try {
      const pagefindSrc = `${location.origin}/pagefind/pagefind-ui.js`;
      const { PagefindUI } = await import(/* @vite-ignore */ pagefindSrc);
      new PagefindUI({ element: '#pagefind-results', showImages: false, showSubResults: true });
    } catch (err) {
      // Pagefind index is only present after `astro build` — not in dev mode.
      if (results)
        results.innerHTML =
          '<p class="search-unavailable">Search is available in the built site. Run pnpm build and pnpm preview to test it locally.</p>';
    } finally {
      setResultsBusy(false);
      scheduleStatusSync();
    }
  }

  function openSearch() {
    if (!modal || !trigger) return;
    trigger.setAttribute('aria-expanded', 'true');
    modal.showModal();
    resetSearchStatus();
    initSearch();
    document.getElementById('pagefind-input')?.focus();
    scheduleStatusSync();
  }

  function closeSearch() {
    if (!modal || !trigger) return;
    modal.close();
    trigger.setAttribute('aria-expanded', 'false');
  }

  trigger?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  // Close on backdrop click (click outside .search-card)
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  // Sync aria-expanded when dialog closes (covers Escape key)
  modal?.addEventListener('close', () => {
    trigger?.setAttribute('aria-expanded', 'false');
  });

  // Open on '/' when no input is focused and modal is closed — spec §4
  document.addEventListener('keydown', (e) => {
    if (
      e.key === '/' &&
      !modal?.open &&
      !(document.activeElement instanceof HTMLInputElement) &&
      !(document.activeElement instanceof HTMLTextAreaElement)
    ) {
      e.preventDefault();
      openSearch();
    }
  });
</script>

<style>
  .sidebar {
    padding-top: 0;
  }

  .search-input-wrap {
    margin-bottom: 1.5rem;
  }

  /* ── Search trigger ── */
  .search-underline-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0;
    border: none;
    border-bottom: 1px solid var(--rule);
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-align: left;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .search-underline-btn:hover {
    border-bottom-color: var(--amber);
    color: var(--ink);
  }

  .search-icon {
    font-weight: 500;
    color: var(--amber-text); /* SC 1.4.3: 4.73:1 on --bg */
    flex-shrink: 0;
  }

  /* ── Search overlay — spec §4 ── */
  /* No backdrop-filter blur — spec §4: "Blur is a visual effect that serves the
     interface's aesthetics, not the reader's task." */
  .search-overlay {
    /* Reset native <dialog> styles */
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    /* Position as full-screen overlay */
    position: fixed;
    inset: 0;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    overscroll-behavior: contain;
  }

  /* Override UA display:none only when open */
  .search-overlay[open] {
    display: flex;
  }

  .search-overlay::backdrop {
    background: var(--overlay-bg);
  }

  .search-card {
    width: min(35rem, calc(100vw - 2rem));
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .search-q {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--amber-text); /* SC 1.4.3: 4.73:1 on --bg */
    flex-shrink: 0;
  }

  /* spec §4: search input uses Fraunces — "feels like composing a thought" */
  .search-field {
    flex: 1;
    border: none;
    background: none;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
    /* outline preserved for :focus-visible — WCAG 2.4.7 */
  }

  .search-field::placeholder {
    color: var(--ink-2); /* upgraded from Ink-3 for WCAG AA at 14px */
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .search-esc-btn {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg-2);
    color: var(--ink-2); /* upgraded from Ink-3 for WCAG AA at 11px */
    cursor: pointer;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .search-esc-btn:hover {
    color: var(--ink);
  }

  .search-results {
    min-height: 3rem;
    max-height: 60vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem 0;
  }

  /* spec §4: footer — keyboard guide only, right-aligned "Pagefind" */
  .search-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--rule);
    background: var(--bg-2);
  }

  .search-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem; /* bumped from 0.7rem for readability */
    color: var(--ink-2); /* upgraded from Ink-3 for WCAG AA */
  }

  .search-powered {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem; /* bumped from 0.7rem for readability */
    color: var(--ink-2); /* upgraded from Ink-3 for WCAG AA */
  }

  .search-shortcut {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg-2);
    color: var(--ink-2);
    margin-left: auto;
    flex-shrink: 0;
  }

  .sidebar-topics {
    min-width: 0;
  }

  @media (min-width: 52.5rem) {
    .sidebar {
      margin-top: -0.25rem;
    }
  }

  .sidebar-heading {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .sidebar-topic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .sidebar-topic-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
    transition: color var(--transition-fast);
  }

  .sidebar-topic-card:hover,
  .sidebar-topic-card:active {
    color: var(--amber-text);
  }

  .sidebar-topic-name {
    min-width: 0;
    color: inherit;
  }

  .sidebar-topic-count {
    flex-shrink: 0;
    color: var(--ink-2);
    font-size: 0.75rem;
  }

  /* Search unavailable / loading messages — injected dynamically */
  :global(.search-unavailable),
  :global(.search-loading) {
    padding: 1rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  /* Pagefind result overrides — spec §4 */
  :global(.pagefind-ui__result) {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--rule);
    border-left: 2px solid transparent;
  }
  :global(.pagefind-ui__result:last-child) {
    border-bottom: none;
  }
  :global(.pagefind-ui__result:focus-within),
  :global(.pagefind-ui__result[aria-selected='true']) {
    border-left-color: var(--amber-text); /* SC 1.4.11: UI state indicator needs 3:1 */
    background: var(--bg-2);
  }
  :global(.pagefind-ui__result-title) {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--ink);
  }
  :global(.pagefind-ui__result-excerpt) {
    font-size: 0.8125rem;
    color: var(--ink-2);
    margin-top: 0.25rem;
  }
  :global(mark) {
    background: none;
    color: var(--amber-text); /* SC 1.4.3: search highlight text needs 4.5:1 */
    font-style: italic;
  }
</style>
