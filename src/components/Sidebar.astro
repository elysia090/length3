---
// Sidebar: search only — spec §1
// "The sidebar contains search and nothing else."
---

<aside class="sidebar" aria-label="Blog sidebar">
  <div class="search-input-wrap">
    <button
      id="search-trigger"
      class="search-underline-btn"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="search-modal"
    >
      <span class="search-icon" aria-hidden="true">Q</span>
      <span class="search-placeholder">/ to search</span>
    </button>
  </div>
</aside>

<!-- Search modal — spec §4 -->
<div
  id="search-modal"
  class="search-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
  hidden
>
  <div class="search-card">
    <div class="search-input-row">
      <span class="search-q" aria-hidden="true">Q</span>
      <input
        id="pagefind-input"
        type="search"
        class="search-field"
        placeholder="Search articles..."
        autocomplete="off"
        aria-label="Search articles"
      />
      <button class="search-esc-btn" id="search-close" aria-label="Close search">esc</button>
    </div>
    <div id="pagefind-results" class="search-results" role="listbox" aria-label="Search results"></div>
    <div class="search-footer" aria-hidden="true">
      <span class="search-hint">↑↓ navigate</span>
      <span class="search-hint">↵ open</span>
      <span class="search-hint">esc close</span>
      <span class="search-powered">Pagefind</span>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('search-trigger') as HTMLButtonElement | null;
  const modal = document.getElementById('search-modal') as HTMLElement | null;
  const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
  let initialized = false;
  let previouslyFocused: HTMLElement | null = null;

  async function initSearch() {
    if (initialized) return;
    initialized = true;
    try {
      const pagefindSrc = `${location.origin}/pagefind/pagefind-ui.js`;
      const { PagefindUI } = await import(/* @vite-ignore */ pagefindSrc);
      new PagefindUI({ element: '#pagefind-results', showImages: false, showSubResults: true });
    } catch {
      // dev mode: pagefind not built yet
    }
  }

  function openSearch() {
    if (!modal || !trigger) return;
    previouslyFocused = document.activeElement as HTMLElement;
    modal.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    initSearch();
    const input = document.getElementById('pagefind-input');
    input?.focus();
  }

  function closeSearch() {
    if (!modal || !trigger) return;
    modal.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    previouslyFocused?.focus();
    previouslyFocused = null;
  }

  // Focus trap — spec §6
  function trapFocus(e: KeyboardEvent) {
    if (!modal || modal.hidden) return;
    if (e.key !== 'Tab') return;

    const focusable = Array.from(
      modal.querySelectorAll<HTMLElement>(
        'button, input, [href], [tabindex]:not([tabindex="-1"])',
      ),
    );
    if (focusable.length === 0) return;
    const first = focusable[0]!;
    const last = focusable[focusable.length - 1]!;

    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  trigger?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.hidden) {
      closeSearch();
      return;
    }
    // Open on '/' when no input is focused and modal is hidden — spec §4
    if (e.key === '/' && modal?.hidden && !(document.activeElement instanceof HTMLInputElement) && !(document.activeElement instanceof HTMLTextAreaElement)) {
      e.preventDefault();
      openSearch();
      return;
    }
    trapFocus(e);
  });
</script>

<style>
  /* ── Sidebar layout — search only ── */
  .sidebar {
    padding-top: 2rem;
  }

  /* ── Search trigger ── */
  .search-underline-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0;
    border: none;
    border-bottom: 1px solid var(--rule);
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-align: left;
    transition: border-color 80ms ease, color 80ms ease;
  }

  .search-underline-btn:hover {
    border-bottom-color: var(--amber);
    color: var(--ink);
  }

  .search-icon {
    font-weight: 600;
    color: var(--amber);
    flex-shrink: 0;
  }

  /* ── Search overlay — spec §4 ── */
  /* No backdrop-filter blur — spec §4: "Blur is a visual effect that serves the
     interface's aesthetics, not the reader's task." */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(28, 26, 24, 0.6);   /* spec §4 */
    z-index: 500;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
  }

  .search-overlay[hidden] {
    display: none;
  }

  /* spec §4: 560px wide, border-radius 6px */
  .search-card {
    width: min(560px, calc(100vw - 2rem));
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 12px 16px;   /* spec §4 */
    border-bottom: 1px solid var(--rule);
  }

  .search-q {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--amber);
    flex-shrink: 0;
  }

  /* spec §4: search input uses Fraunces — "feels like composing a thought" */
  .search-field {
    flex: 1;
    border: none;
    background: none;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
    outline: none;
  }

  .search-field::placeholder {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .search-esc-btn {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg-2);
    color: var(--ink-3);
    cursor: pointer;
    flex-shrink: 0;
    transition: color 80ms ease;
  }

  .search-esc-btn:hover {
    color: var(--ink);
  }

  .search-results {
    min-height: 3rem;
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  /* spec §4: footer — keyboard guide only, right-aligned "Pagefind" */
  .search-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 16px;
    border-top: 1px solid var(--rule);
    background: var(--bg-2);
  }

  .search-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;   /* spec §4: 0.7rem */
    color: var(--ink-3);
  }

  .search-powered {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
  }

  /* Pagefind result overrides — spec §4 */
  :global(.pagefind-ui__result) {
    padding: 10px 16px;   /* spec §4 */
    border-bottom: 1px solid var(--rule);
    border-left: 2px solid transparent;
  }
  :global(.pagefind-ui__result:last-child) {
    border-bottom: none;
  }
  :global(.pagefind-ui__result:focus-within),
  :global(.pagefind-ui__result[aria-selected='true']) {
    border-left-color: var(--amber);
    background: var(--bg-2);
  }
  :global(.pagefind-ui__result-title) {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--ink);
  }
  :global(.pagefind-ui__result-excerpt) {
    font-size: 0.8125rem;
    color: var(--ink-2);
    margin-top: 0.25rem;
  }
  :global(mark) {
    background: none;
    color: var(--amber);
    font-style: italic;
  }
</style>
