---
interface TopicSummary {
  count: number;
  href: string;
  name: string;
}

interface Props {
  topics: TopicSummary[];
}

const { topics } = Astro.props;
---

<aside class="sidebar" aria-label="Blog sidebar">
  <div class="search-input-wrap">
    <button
      id="search-trigger"
      class="search-underline-btn"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="search-modal"
    >
      <span class="search-icon" aria-hidden="true">Q</span>
      <span class="search-placeholder">Search articles…</span>
      <kbd class="search-shortcut" aria-label="keyboard shortcut: slash">/</kbd>
    </button>
  </div>
  {
    topics.length > 0 && (
      <section class="sidebar-topics" aria-labelledby="sidebar-topics-heading">
        <h2 class="sidebar-heading" id="sidebar-topics-heading">
          Topics
        </h2>
        <ul class="sidebar-topic-list">
          {topics.map((topic) => (
            <li>
              <a href={topic.href} class="sidebar-topic-card" rel="tag">
                <span class="sidebar-topic-name">#{topic.name}</span>
                <span class="sidebar-topic-count">{topic.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</aside>

<dialog id="search-modal" class="search-overlay" aria-label="Search">
  <div class="search-card">
    <div class="search-card-header">
      <span class="search-q" aria-hidden="true">Q</span>
      <p class="search-title">Search</p>
      <button class="search-esc-btn" id="search-close" aria-label="Close search" autofocus>
        esc
      </button>
    </div>
    <p id="search-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    <div
      id="pagefind-ui"
      class="search-results"
      role="region"
      aria-label="Search results"
      aria-busy="false"
    >
    </div>
    <div class="search-footer" aria-hidden="true">
      <span class="search-hint">↑↓ navigate</span>
      <span class="search-hint">↵ open</span>
      <span class="search-hint">esc close</span>
      <span class="search-powered">Pagefind</span>
    </div>
  </div>
</dialog>

<script>
  import {
    createBrowserSearchBootstrapDeps,
    createPagefindSearchController,
  } from '../lib/pagefind-search';
  import { createSearchModalController } from '../lib/search-modal';

  const trigger = document.getElementById('search-trigger') as HTMLButtonElement | null;
  const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
  const pagefindMount = document.getElementById('pagefind-ui');
  const status = document.getElementById('search-status');

  if (
    trigger &&
    modal &&
    closeBtn &&
    pagefindMount instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    const searchController = createPagefindSearchController(
      {
        mount: pagefindMount,
        mountSelector: '#pagefind-ui',
        status,
      },
      createBrowserSearchBootstrapDeps({
        browserWindow: window,
        isDev: import.meta.env.DEV,
      }),
    );

    createSearchModalController({
      closeButton: closeBtn,
      document,
      modal,
      onOpenSearch: () => searchController.open(),
      trigger,
    });
  }
</script>

<style>
  .sidebar {
    padding-top: 0;
  }

  .search-input-wrap {
    margin-bottom: 1.5rem;
  }

  .search-underline-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0;
    border: none;
    border-bottom: 1px solid var(--rule);
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-align: left;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .search-underline-btn:hover {
    border-bottom-color: var(--amber);
    color: var(--ink);
  }

  .search-icon {
    font-weight: 500;
    color: var(--amber-text);
    flex-shrink: 0;
  }

  .search-overlay {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    position: fixed;
    inset: 0;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    overscroll-behavior: contain;
  }

  .search-overlay[open] {
    display: flex;
  }

  .search-overlay::backdrop {
    background: var(--overlay-bg);
  }

  .search-card {
    width: min(35rem, calc(100vw - 2rem));
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .search-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .search-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .search-q {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--amber-text);
    flex-shrink: 0;
  }

  .search-esc-btn {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg-2);
    color: var(--ink-2);
    cursor: pointer;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .search-esc-btn:hover {
    color: var(--ink);
  }

  .search-results {
    min-height: 3rem;
  }

  .search-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--rule);
    background: var(--bg-2);
  }

  .search-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .search-powered {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .search-shortcut {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg-2);
    color: var(--ink-2);
    margin-left: auto;
    flex-shrink: 0;
  }

  .sidebar-topics {
    min-width: 0;
  }

  @media (min-width: 52.5rem) {
    .sidebar {
      margin-top: -0.25rem;
    }
  }

  .sidebar-heading {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .sidebar-topic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .sidebar-topic-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
    transition: color var(--transition-fast);
  }

  .sidebar-topic-card:hover,
  .sidebar-topic-card:active {
    color: var(--amber-text);
  }

  .sidebar-topic-name {
    min-width: 0;
    color: inherit;
  }

  .sidebar-topic-count {
    flex-shrink: 0;
    color: var(--ink-2);
    font-size: 0.75rem;
  }

  :global(.search-unavailable),
  :global(.search-loading),
  :global(.search-error) {
    padding: 1rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  :global(#pagefind-ui .pagefind-ui__form) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  :global(#pagefind-ui .pagefind-ui__form::before) {
    display: none;
  }

  :global(#pagefind-ui .pagefind-ui__search-input) {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
  }

  :global(#pagefind-ui .pagefind-ui__search-input::placeholder) {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  :global(#pagefind-ui .pagefind-ui__search-clear) {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg-2);
    color: var(--ink-2);
  }

  :global(#pagefind-ui .pagefind-ui__search-clear:hover) {
    color: var(--ink);
  }

  :global(#pagefind-ui .pagefind-ui__drawer) {
    max-height: 60vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem 0;
  }

  :global(#pagefind-ui .pagefind-ui__message) {
    padding: 1rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  :global(#pagefind-ui .pagefind-ui__results) {
    margin: 0;
    padding: 0;
  }

  :global(.pagefind-ui__result) {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--rule);
    border-left: 2px solid transparent;
  }

  :global(.pagefind-ui__result:last-child) {
    border-bottom: none;
  }

  :global(.pagefind-ui__result:focus-within),
  :global(.pagefind-ui__result[aria-selected='true']) {
    border-left-color: var(--amber-text);
    background: var(--bg-2);
  }

  :global(.pagefind-ui__result-title) {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--ink);
  }

  :global(.pagefind-ui__result-excerpt) {
    font-size: 0.8125rem;
    color: var(--ink-2);
    margin-top: 0.25rem;
  }

  :global(mark) {
    background: none;
    color: var(--amber-text);
    font-style: italic;
  }
</style>
