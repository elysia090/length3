---
interface Props {
  tagCounts: Map<string, number>;
  totalPosts: number;
}

const { tagCounts, totalPosts } = Astro.props;
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
const topTags = sortedTags.slice(0, 15);
---

<aside class="sidebar" aria-label="Blog sidebar">

  <!-- SEARCH -->
  <section class="sidebar-section">
    <h2 class="sidebar-label">SEARCH</h2>
    <div class="search-input-wrap">
      <button
        id="search-trigger"
        class="search-underline-btn"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="search-modal"
      >
        <span class="search-icon">Q</span>
        <span class="search-placeholder">/ to search</span>
      </button>
    </div>
  </section>

  <!-- STATS -->
  <section class="sidebar-section">
    <h2 class="sidebar-label">STATS</h2>
    <div class="stats-grid">
      <div class="stat-cell">
        <span class="stat-num">{totalPosts}</span>
        <span class="stat-name">articles</span>
      </div>
      <div class="stat-cell">
        <span class="stat-num">{tagCounts.size}</span>
        <span class="stat-name">tags</span>
      </div>
      <div class="stat-cell">
        <span class="stat-num">∞</span>
        <span class="stat-name">ongoing</span>
      </div>
      <div class="stat-cell">
        <span class="stat-num">1</span>
        <span class="stat-name">author</span>
      </div>
    </div>
  </section>

  <!-- TAGS -->
  {
    topTags.length > 0 && (
      <section class="sidebar-section">
        <h2 class="sidebar-label">TAGS</h2>
        <ul class="tag-list">
          {topTags.map(([tag, count]) => (
            <li class="tag-row">
              <a href={`/tags/${tag.toLowerCase()}`} class="tag-name">#{tag}</a>
              <span class="tag-dots" aria-hidden="true"></span>
              <span class="tag-count">{count}</span>
            </li>
          ))}
        </ul>
        {sortedTags.length > 15 && (
          <a href="/tags" class="all-tags-link">all tags →</a>
        )}
      </section>
    )
  }

</aside>

<!-- Search modal (fullscreen) -->
<div id="search-modal" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <div class="search-card">
    <div class="search-input-row">
      <span class="search-q" aria-hidden="true">Q</span>
      <input
        id="pagefind-input"
        type="search"
        class="search-field"
        placeholder="Search articles..."
        autocomplete="off"
        aria-label="Search"
      />
      <button class="search-esc-btn" id="search-close" aria-label="Close search">esc</button>
    </div>
    <div id="pagefind-results" class="search-results"></div>
    <div class="search-footer">
      <span class="search-hint">↑↓ navigate</span>
      <span class="search-hint">↵ open</span>
      <span class="search-hint">esc close</span>
      <span class="search-powered">Powered by Pagefind</span>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('search-trigger') as HTMLButtonElement | null;
  const modal = document.getElementById('search-modal') as HTMLElement | null;
  const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
  let initialized = false;

  async function initSearch() {
    if (initialized) return;
    initialized = true;
    try {
      // @ts-expect-error runtime asset — use variable to prevent Vite from resolving at build time
      const pagefindSrc = `${location.origin}/pagefind/pagefind-ui.js`;
      const { PagefindUI } = await import(/* @vite-ignore */ pagefindSrc);
      new PagefindUI({ element: '#pagefind-results', showImages: false, showSubResults: true });
    } catch {
      // dev mode: pagefind not built yet
    }
  }

  function openSearch() {
    if (!modal || !trigger) return;
    modal.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    initSearch();
    const input = document.getElementById('pagefind-input');
    input?.focus();
  }

  function closeSearch() {
    if (!modal || !trigger) return;
    modal.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  trigger?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && !modal?.hidden === false) {
      e.preventDefault();
      openSearch();
    }
  });
</script>

<style>
  /* ── Sidebar layout ── */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 2rem;
  }

  .sidebar-section {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .sidebar-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }

  /* ── Search input ── */
  .search-underline-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.4rem 0;
    border: none;
    border-bottom: 1px solid var(--color-border);
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-align: left;
    transition: border-color 0.15s, color 0.15s;
  }

  .search-underline-btn:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-text);
  }

  .search-icon {
    font-weight: 600;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── Stats grid ── */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
    border-radius: 1px;
  }

  .stat-cell {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stat-cell:nth-child(2n) { border-right: none; }
  .stat-cell:nth-child(n+3) { border-bottom: none; }

  .stat-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .stat-name {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    text-transform: lowercase;
  }

  /* ── Tag list ── */
  .tag-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .tag-row {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .tag-name {
    color: var(--color-tag);
    flex-shrink: 0;
    transition: color 0.1s;
  }

  .tag-name:hover {
    color: var(--color-accent);
  }

  .tag-dots {
    flex: 1;
    border-bottom: 1px dotted var(--color-border);
    margin-bottom: 0.15em;
  }

  .tag-count {
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .all-tags-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
    transition: color 0.1s;
  }

  .all-tags-link:hover {
    color: var(--color-accent);
  }

  /* ── Search overlay ── */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(18, 18, 16, 0.72);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 500;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-card {
    width: min(640px, calc(100vw - 2rem));
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .search-q {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .search-field {
    flex: 1;
    border: none;
    background: none;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-text);
    outline: none;
  }

  .search-field::placeholder {
    color: var(--color-muted);
  }

  .search-esc-btn {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface);
    color: var(--color-muted);
    cursor: pointer;
    flex-shrink: 0;
  }

  .search-results {
    min-height: 3rem;
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  .search-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1.25rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .search-hint {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-muted);
  }

  .search-powered {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-muted);
    opacity: 0.7;
  }

  /* Pagefind result overrides */
  :global(.pagefind-ui__result) {
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  :global(.pagefind-ui__result:last-child) { border-bottom: none; }
  :global(.pagefind-ui__result-title) {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-text);
  }
  :global(.pagefind-ui__result-excerpt) {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }
  :global(mark) { background: #fef3c7; color: var(--color-text); }
</style>
