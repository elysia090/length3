---
import { getSearchCopy } from '../features/search/search-copy';
import { getSiteCopy } from '../i18n/site-copy';

interface TopicSummary {
  count: number;
  href: string;
  name: string;
}

interface Props {
  lang?: 'en' | 'ja';
  topics: TopicSummary[];
}

const { topics, lang } = Astro.props;
const copy = getSearchCopy(lang);
const siteCopy = getSiteCopy(lang);
---

<div data-sidebar-search>
  <aside class="sidebar" aria-label={siteCopy.blogSidebar}>
    <div class="search-input-wrap">
      <button
        type="button"
        class="search-trigger-btn"
        data-search-trigger
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <svg
          class="search-icon-svg"
          aria-hidden="true"
          focusable="false"
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"></circle>
          <line
            x1="10.5"
            y1="10.5"
            x2="14.5"
            y2="14.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
        </svg>
        <span class="search-placeholder">{copy.searchPlaceholder}</span>
        <kbd class="search-shortcut" aria-label={siteCopy.keyboardShortcutSlash}>/</kbd>
      </button>
    </div>
    {
      topics.length > 0 && (
        <section class="sidebar-topics" aria-labelledby="sidebar-topics-heading">
          <h2 class="sidebar-heading" id="sidebar-topics-heading">
            {siteCopy.topics}
          </h2>
          <ul class="sidebar-topic-list">
            {topics.map((topic) => (
              <li>
                <a href={topic.href} class="sidebar-topic-card" rel="tag">
                  <span class="sidebar-topic-name">#{topic.name}</span>
                  <span class="sidebar-topic-count">{topic.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </aside>

  <dialog
    class="search-overlay"
    aria-label={copy.searchDialogLabel}
    data-search-modal
    data-search-lang={lang}
  >
  </dialog>

  <template data-search-modal-template>
    <div class="search-card">
      <div class="search-card-header">
        <svg
          class="search-header-icon"
          aria-hidden="true"
          focusable="false"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"></circle>
          <line
            x1="10.5"
            y1="10.5"
            x2="14.5"
            y2="14.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
        </svg>
        <p class="search-title">{copy.searchDialogLabel}</p>
        <button
          type="button"
          class="search-esc-btn"
          data-search-close
          aria-label={copy.closeSearch}
        >
          <svg
            class="search-close-icon"
            aria-hidden="true"
            focusable="false"
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <line
              x1="1"
              y1="1"
              x2="11"
              y2="11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></line>
            <line
              x1="11"
              y1="1"
              x2="1"
              y2="11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></line>
          </svg>
        </button>
      </div>
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-search-status></p>
      <div
        class="search-results"
        role="region"
        aria-label={copy.resultsLabel}
        aria-busy="false"
        data-pagefind-ui
      >
      </div>
      <div class="search-empty-state" data-search-empty-state data-search-state="empty" hidden>
        <p class="search-empty-title">{copy.emptyTitle}</p>
        <p class="search-empty-body">{copy.emptyBody}</p>
      </div>
      <div class="search-footer" aria-hidden="true">
        <span class="search-hint search-hint--desktop">{copy.searchHintNavigate}</span>
        <span class="search-hint search-hint--desktop">{copy.searchHintOpen}</span>
        <span class="search-hint search-hint--desktop">{copy.searchHintClose}</span>
        <span class="search-hint search-hint--mobile">{copy.searchHintMobileOpen}</span>
        <span class="search-powered">Pagefind</span>
      </div>
    </div>
  </template>
</div>

<script>
  import { initializeSidebarSearch } from '../features/search/sidebar-search';

  initializeSidebarSearch();
</script>
