---
// No props — toggled by JS
---

<button
  id="search-trigger"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="search-modal"
  class="search-trigger"
>
  Search
</button>

<dialog id="search-modal" aria-modal="true" aria-label="Search">
  <div class="search-inner">
    <div id="pagefind-ui-mount"></div>
    <button class="close-btn" id="search-close" aria-label="Close search">&times;</button>
  </div>
</dialog>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<script>
  const trigger = document.getElementById('search-trigger') as HTMLButtonElement | null;
  const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
  let initialized = false;

  async function initSearch() {
    if (initialized) return;
    initialized = true;
    // @ts-expect-error — Pagefind UI is loaded at runtime from /pagefind/
    const { PagefindUI } = await import('/pagefind/pagefind-ui.js');
    new PagefindUI({
      element: '#pagefind-ui-mount',
      showImages: false,
      showSubResults: true,
    });
  }

  trigger?.addEventListener('click', async () => {
    await initSearch();
    modal?.showModal();
    trigger.setAttribute('aria-expanded', 'true');
  });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
    trigger?.setAttribute('aria-expanded', 'false');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
      trigger?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: transparent;
    color: var(--color-muted);
    font-size: 0.875rem;
    cursor: pointer;
    width: 100%;
    text-align: left;
    transition: border-color 0.15s, color 0.15s;
  }

  .search-trigger:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  dialog {
    border: none;
    border-radius: 8px;
    padding: 0;
    max-width: 600px;
    width: 90vw;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    background: var(--color-bg);
    color: var(--color-text);
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }

  .search-inner {
    padding: 1.25rem;
    position: relative;
  }

  .close-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--color-muted);
    line-height: 1;
    padding: 0.25rem;
  }

  .close-btn:hover {
    color: var(--color-text);
  }
</style>
