---
import { getSiteCopy } from '../i18n/site-copy';
import type { TocHeading } from '../features/article/types';

interface Props {
  headings: TocHeading[];
  lang?: 'en' | 'ja';
}

const { headings, lang = 'en' } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
const copy = getSiteCopy(lang);
---

{
  filtered.length > 0 && (
    <nav class="toc" aria-label={copy.tableOfContents}>
      <span class="toc-label" aria-hidden="true">
        {copy.contents}
      </span>
      <ul>
        {filtered.map((h) => (
          <li class={`toc-item toc-depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link" data-heading={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  import { initializeTableOfContents } from '../features/article/toc-controller';

  initializeTableOfContents();
</script>
