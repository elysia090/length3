---
import { getSiteCopy } from '../lib/ui-copy';
import type { TocHeading } from '../lib/types';

interface Props {
  headings: TocHeading[];
  lang?: 'en' | 'ja';
}

const { headings, lang = 'en' } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
const copy = getSiteCopy(lang);
---

{
  filtered.length > 0 && (
    <nav class="toc" aria-label={copy.tableOfContents}>
      <span class="toc-label" aria-hidden="true">
        {copy.contents}
      </span>
      <ul>
        {filtered.map((h) => (
          <li class={`toc-item toc-depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link" data-heading={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  import { initializeTableOfContents } from '../lib/toc-controller';

  initializeTableOfContents();
</script>

<style>
  .toc-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
    padding-left: 0.5rem; /* toc-link と左端を揃える */
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-depth-3 {
    margin-left: 0.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0 0.375rem 0.5rem;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    border-left: 0.125rem solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .toc-link:hover,
  .toc-link:active {
    color: var(--ink);
    border-left-color: var(--rule);
  }

  @media (pointer: coarse) {
    .toc-link {
      min-height: 2.75rem;
      display: flex;
      align-items: center;
    }
  }

  /* アクティブ項目: 常に前面 — 読者の現在地を示す */
  .toc-link.active {
    color: var(--amber-text);
    border-left-color: var(--amber-text);
  }
</style>
