---
import type { TocHeading } from '../lib/types';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filtered.length > 0 && (
    <nav class="toc" aria-label="Table of Contents">
      {/* spec §8: <details> wraps the TOC.
          Desktop (≥ 720px): starts open, summary acts as a static label.
          Mobile (< 720px):  JS removes `open` so it starts collapsed. */}
      <details class="toc-details" open>
        <summary class="toc-label">Contents</summary>
        <ul>
          {filtered.map((h) => (
            <li class={`toc-item toc-depth-${h.depth}`}>
              <a href={`#${h.slug}`} class="toc-link" data-heading={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

<script>
  const tocNav = document.querySelector<HTMLElement>('.toc');
  const tocDetails = document.querySelector<HTMLDetailsElement>('.toc-details');
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const headingEls = document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]');

  // spec §8: collapse TOC on mobile (< 720px) — starts open in SSR/desktop
  // Use matchMedia so the state updates on resize/orientation change
  const mobileQuery = window.matchMedia('(max-width: 719px)');
  const tocSummary = tocDetails?.querySelector<HTMLElement>('.toc-label');

  function syncTocOpen(mobile: boolean) {
    if (!tocDetails) return;
    if (mobile) {
      tocDetails.removeAttribute('open');
      // Restore keyboard access on mobile: summary is an interactive toggle
      tocSummary?.removeAttribute('tabindex');
    } else {
      tocDetails.setAttribute('open', '');
      // SC 2.1.1: on desktop the summary is a visual label only (pointer-events: none in CSS).
      // Remove it from the tab order so keyboard users cannot accidentally collapse the TOC
      // with no way to reopen it (JS only watches viewport resize, not user keypress).
      tocSummary?.setAttribute('tabindex', '-1');
    }
  }
  syncTocOpen(mobileQuery.matches);
  mobileQuery.addEventListener('change', (e) => syncTocOpen(e.matches));

  // ── Active section tracking ──────────────────────────────────
  if (links.length > 0 && headingEls.length > 0) {
    // Map heading id → link for O(1) lookup instead of scanning all links per entry
    const linkByHeadingId = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const id = link.getAttribute('href')?.slice(1);
      if (id) linkByHeadingId.set(id, link);
    }

    let activeLink: HTMLAnchorElement | null = null;
    const intersecting = new Set<string>();

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            intersecting.add(entry.target.id);
          } else {
            intersecting.delete(entry.target.id);
          }
        }
        // Pick the topmost intersecting heading in document order
        let next: HTMLAnchorElement | null = null;
        for (const el of headingEls) {
          if (intersecting.has(el.id)) {
            next = linkByHeadingId.get(el.id) ?? null;
            break;
          }
        }
        if (next !== activeLink) {
          activeLink?.classList.remove('active');
          next?.classList.add('active');
          activeLink = next;
        }
      },
      // -55%: heading must be in the top 45% of the viewport to be "active"
      { rootMargin: '0px 0px -55% 0px', threshold: 0 },
    );
    for (const el of headingEls) sectionObserver.observe(el);
  }

  // ── TOC fade-out when article body ends — spec §4 ────────────
  // "When the reader scrolls past the bottom of the article body, the TOC fades
  //  to opacity: 0 over 200ms and receives pointer-events: none + visibility: hidden"
  if (tocNav) {
    const articleBody = document.querySelector<HTMLElement>('article[data-pagefind-body]');
    if (articleBody) {
      // Sentinel element placed at the end of the article
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      articleBody.appendChild(sentinel);

      // Guard: don't respond to the initial IntersectionObserver callback that
      // fires synchronously on observe() — only act after the user has scrolled.
      // Without this, hash-navigation page loads (e.g. #section-3) can trigger
      // the fade immediately before the reader has seen anything.
      let userHasScrolled = false;
      window.addEventListener(
        'scroll',
        () => {
          userHasScrolled = true;
        },
        { once: true, passive: true },
      );

      const fadeObserver = new IntersectionObserver(
        ([entry]) => {
          if (!userHasScrolled) return;
          // Sentinel scrolled above viewport → article body is done
          const past = Boolean(entry && !entry.isIntersecting && entry.boundingClientRect.top < 0);
          tocNav.classList.toggle('toc--hidden', past);
        },
        { threshold: 0 },
      );
      fadeObserver.observe(sentinel);
    }
  }

  // ── Smooth scroll on TOC link click — spec §5 ────────────────
  for (const link of links) {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href) return;
      const target = document.querySelector<HTMLElement>(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth' });
      history.pushState(null, '', href);
    });
  }
</script>

<style>
  .toc {
    transition: opacity 200ms ease; /* spec §5: TOC disappearance 200ms */
  }

  /* Applied by JS when the reader scrolls past the end of the article body */
  .toc--hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* ── <details> / <summary> reset ── */
  /* <summary> replaces the old <p class="toc-label">.
     Reset list-item display and hide the native ▶ marker. */
  .toc-label {
    font-family: var(--font-mono);
    font-size: 0.8rem; /* bumped from 0.75rem to match TOC link size */
    letter-spacing: 0.14em;
    color: var(--ink-2); /* upgraded from Ink-3 for WCAG AA at small size */
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
    list-style: none;
  }

  /* Remove the native disclosure triangle in all browsers */
  .toc-label::marker,
  .toc-label::-webkit-details-marker {
    display: none;
  }

  /* Desktop (≥ 720px): summary is a visual label, not an interactive toggle */
  @media (min-width: 720px) {
    .toc-label {
      pointer-events: none;
      cursor: default;
    }
  }

  /* Mobile (≤ 719px): summary is a collapsible toggle — spec §8 */
  @media (max-width: 719px) {
    .toc-label {
      cursor: pointer;
      display: flex;
      align-items: center;
      min-height: 44px; /* WCAG 2.5.8: touch target */
      margin-bottom: 0;
      padding: 0;
    }

    /* Chevron indicator */
    .toc-label::after {
      content: '↓';
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--ink-2); /* SC 1.4.11: was ink-3 (2.78:1), ink-2 gives 7.73:1 on --bg */
      margin-left: auto;
      transition: transform var(--transition-fast);
      display: block;
    }

    .toc-details[open] > .toc-label::after {
      transform: rotate(180deg);
    }

    .toc-details > ul {
      margin-top: 0.5rem;
    }
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    position: relative;
  }

  .toc-depth-3 {
    margin-left: 0.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0 0.375rem 0.5rem;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    border-left: 2px solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .toc-link:hover,
  .toc-link:active {
    color: var(--ink);
    border-left-color: var(--rule);
  }

  @media (pointer: coarse) {
    .toc-link {
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }

  /* SC 1.4.3 + SC 1.4.11: --amber-text (4.73:1) replaces --amber (2.83:1) */
  .toc-link.active {
    color: var(--amber-text);
    border-left-color: var(--amber-text);
  }

  /* spec §4: H3 font-size 0.75rem */
  .toc-depth-3 .toc-link {
    font-size: 0.75rem;
  }
</style>
