---
import type { TocHeading } from '../lib/types';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filtered.length > 0 && (
    <nav class="toc" aria-label="Table of Contents">
      <p class="toc-label">Contents</p>
      <ul>
        {filtered.map((h) => (
          <li class={`toc-item toc-depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link" data-heading={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    transition: opacity 200ms ease; /* spec §5: TOC disappearance 200ms */
  }

  /* Applied by JS when the reader scrolls past the end of the article body */
  .toc--hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .toc-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    position: relative;
  }

  .toc-depth-3 {
    margin-left: 0.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0 0.375rem 0.5rem;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    border-left: 2px solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .toc-link:hover,
  .toc-link:active {
    color: var(--ink);
    border-left-color: var(--rule);
  }

  @media (pointer: coarse) {
    .toc-link {
      min-height: 2.75rem;
      display: flex;
      align-items: center;
    }
  }

  /* SC 1.4.3 + SC 1.4.11: --amber-text (4.73:1) replaces --amber (2.83:1) */
  .toc-link.active {
    color: var(--amber-text);
    border-left-color: var(--amber-text);
  }

  /* spec §4: H3 font-size 0.75rem */
  .toc-depth-3 .toc-link {
    font-size: 0.75rem;
  }
</style>
