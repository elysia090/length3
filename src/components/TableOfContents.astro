---
import type { TocHeading } from '../types/blog';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filtered.length > 0 && (
    <nav class="toc" aria-label="Table of Contents">
      {/* spec §6: TOC <ul> carries aria-label="Table of Contents" */}
      <p class="toc-label">Contents</p>
      <ul aria-label="Table of Contents">
        {filtered.map((h) => (
          <li class={`toc-item toc-depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link" data-heading={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const tocNav = document.querySelector<HTMLElement>('.toc');
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const headingEls = document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]');

  // ── Active section tracking ──────────────────────────────────
  if (links.length > 0 && headingEls.length > 0) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            for (const link of links) {
              link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`);
            }
          }
        }
      },
      { rootMargin: '0px 0px -55% 0px', threshold: 0 },
    );
    for (const el of headingEls) sectionObserver.observe(el);
  }

  // ── TOC fade-out when article body ends — spec §4 ────────────
  // "When the reader scrolls past the bottom of the article body, the TOC fades
  //  to opacity: 0 over 200ms and receives pointer-events: none + visibility: hidden"
  if (tocNav) {
    const articleBody = document.querySelector<HTMLElement>('article[data-pagefind-body]');
    if (articleBody) {
      // Sentinel element placed at the end of the article
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      articleBody.appendChild(sentinel);

      const fadeObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry && !entry.isIntersecting && entry.boundingClientRect.top < 0) {
            // Sentinel has scrolled above the viewport — article is done
            tocNav.style.opacity = '0';
            tocNav.style.pointerEvents = 'none';
            tocNav.style.visibility = 'hidden';
          } else {
            tocNav.style.opacity = '';
            tocNav.style.pointerEvents = '';
            tocNav.style.visibility = '';
          }
        },
        { threshold: 0 },
      );
      fadeObserver.observe(sentinel);
    }
  }

  // ── Smooth scroll on TOC link click — spec §5 ────────────────
  for (const link of links) {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href) return;
      const target = document.querySelector<HTMLElement>(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth' });
      history.pushState(null, '', href);
    });
  }
</script>

<style>
  .toc {
    transition: opacity 200ms ease;   /* spec §5: TOC disappearance 200ms */
  }

  .toc-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;    /* bumped from 0.75rem to match TOC link size */
    letter-spacing: 0.14em;
    color: var(--ink-2);   /* upgraded from Ink-3 for WCAG AA at small size */
    text-transform: uppercase;
    margin-bottom: 16px;   /* spec §4 */
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    position: relative;
  }

  /* spec §4: H3 sub-items margin-left 12px */
  .toc-depth-3 {
    margin-left: 12px;
  }

  /* spec §4: padding 6px 0, padding-left 8px, border-left 2px transparent */
  .toc-link {
    display: block;
    padding: 6px 0 6px 8px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    border-left: 2px solid transparent;
    transition: color 80ms ease, border-color 80ms ease;
  }

  .toc-link:hover {
    color: var(--ink);
    border-left-color: var(--rule);
  }

  /* spec §4: active — amber border-left + amber text, 80ms ease */
  .toc-link.active {
    color: var(--amber);
    border-left-color: var(--amber);
  }

  /* spec §4: H3 font-size 0.75rem */
  .toc-depth-3 .toc-link {
    font-size: 0.75rem;
  }

  /* ── <details> for mobile (≤ 640px) — spec §8 ── */
  /* At ≤ 640px the TOC wraps in a collapsible details element.
     We implement this via CSS: hide the normal nav and show a details version. */
</style>
