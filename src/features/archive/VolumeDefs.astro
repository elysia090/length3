---
/**
 * 体積の立方体が面に使う網点。中間色は作らず、4×4 の升目に置く点の数で
 * 明るさを分ける（2/16、4/16、8/16）。墨は紙の上、灯は暗い面の上。
 * ページに一度だけ置き、各 <VolumeCube> は id で参照する。
 */
const tiles = {
  sparse: [
    [0, 0],
    [2, 2],
  ],
  quarter: [
    [0, 0],
    [2, 0],
    [0, 2],
    [2, 2],
  ],
  half: [
    [0, 0],
    [2, 0],
    [1, 1],
    [3, 1],
    [0, 2],
    [2, 2],
    [1, 3],
    [3, 3],
  ],
} as const;
const sets = [
  {
    id: 'l3-ink',
    ground: 'var(--bg)',
    dot: 'var(--ink)',
    faces: { top: 'sparse', left: 'quarter', right: 'half' },
  },
  {
    id: 'l3-lamp',
    ground: 'var(--code-bg)',
    dot: 'var(--amber-lt)',
    faces: { top: 'half', left: 'quarter', right: 'sparse' },
  },
] as const;
---

<svg class="volume-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    {
      sets.map((set) =>
        Object.entries(set.faces).map(([face, tile]) => (
          <pattern id={`${set.id}-${face}`} width="4" height="4" patternUnits="userSpaceOnUse">
            <rect width="4" height="4" style={`fill: ${set.ground}`} />
            {tiles[tile].map(([x, y]) => (
              <rect x={x} y={y} width="1" height="1" style={`fill: ${set.dot}`} />
            ))}
          </pattern>
        )),
      )
    }
  </defs>
</svg>

<style>
  .volume-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
