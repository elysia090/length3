---
import { getSearchCopy } from './search-copy';
import { getSiteCopy } from '../../i18n/site-copy';

interface Props {
  lang?: 'en' | 'ja';
}

const { lang } = Astro.props;
const copy = getSearchCopy(lang);
const siteCopy = getSiteCopy(lang);
---

<div data-search-panel>
  <div class="search-input-wrap">
    <button
      type="button"
      class="search-trigger-btn"
      data-search-trigger
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <svg
        class="search-icon-svg"
        aria-hidden="true"
        focusable="false"
        width="14"
        height="14"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"></circle>
        <line
          x1="10.5"
          y1="10.5"
          x2="14.5"
          y2="14.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></line>
      </svg>
      <span class="search-placeholder">{copy.searchPlaceholder}</span>
      <kbd class="search-shortcut" aria-label={siteCopy.keyboardShortcutSlash}>/</kbd>
    </button>
  </div>

  <dialog
    class="search-overlay"
    aria-label={copy.searchDialogLabel}
    data-search-modal
    data-search-lang={lang}
  >
  </dialog>

  <template data-search-modal-template>
    <!-- showModal() の初期フォーカスがカード自身に来るようにする。
         これがないと閉じるボタンにフォーカスが乗り、開いた瞬間に
         フォーカスリングが出る。 -->
    <div class="search-card" tabindex="-1" autofocus>
      <div class="search-card-header">
        <p class="search-title">{copy.searchDialogLabel}</p>
        <button
          type="button"
          class="search-esc-btn"
          data-search-close
          aria-label={copy.closeSearch}
        >
          <svg
            class="search-close-icon"
            aria-hidden="true"
            focusable="false"
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <line
              x1="1"
              y1="1"
              x2="11"
              y2="11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></line>
            <line
              x1="11"
              y1="1"
              x2="1"
              y2="11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></line>
          </svg>
        </button>
      </div>
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-search-status></p>
      <div
        class="search-results"
        role="region"
        aria-label={copy.resultsLabel}
        aria-busy="false"
        data-pagefind-ui
      >
      </div>
      <div class="search-empty-state" data-search-empty-state data-search-state="empty" hidden>
        <p class="search-empty-title">{copy.emptyTitle}</p>
        <p class="search-empty-body">{copy.emptyBody}</p>
      </div>
    </div>
  </template>

  <script>
    import { initializeSearchPanel } from './search-panel';

    initializeSearchPanel();
  </script>
</div>
