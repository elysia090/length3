---
/**
 * About の絵。ミケランジェロ《アダムの創造》（1512 年頃）を墨と琥珀の
 * 網点で二色刷りにし、手持ちのカメラで撮る。文字も仕掛けも置かない。
 * 版は scripts/adam/bake.ts が data/ から焼く（琥珀をどこに効かせるかも
 * そこで決める）。刷りは stage.ts、揺れは handheld.ts。
 */
import plate from './adam.webp?url';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure
  class:list={['adam', className]}
  data-adam
  data-src={plate}
  role="img"
  aria-label="Michelangelo, The Creation of Adam (c. 1512), printed in one-bit dots: the two hands reaching across the gap."
>
  <canvas class="adam-canvas" aria-hidden="true"></canvas>
</figure>

<script>
  import { mountAdam } from './stage';

  for (const el of document.querySelectorAll<HTMLElement>('[data-adam]')) mountAdam(el);
</script>

<style>
  /* 大きさは置く側が決める。絵は箱いっぱいに刷る。 */
  .adam {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    line-height: 0;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .adam-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>
