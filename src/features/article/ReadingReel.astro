---
/**
 * 目次の下に置く、読んだぶんだけ積まれる立方体（reel.ts）。進み具合は
 * 上端の進捗バーが支援技術に伝えているので、こちらは絵として隠す。
 */
---

<div class="reading-reel" data-reading-reel aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import { mountReel } from './reel';

  for (const el of document.querySelectorAll<HTMLElement>('[data-reading-reel]')) mountReel(el);
</script>

<style>
  /* 目次の列の下段。目次とは重ならないので地の面は敷かない。 */
  .reading-reel {
    flex: none;
    margin-top: 1.5rem;
    padding-block: 1rem 0.5rem;
    border-top: 0.0625rem solid var(--rule);
  }

  .reading-reel canvas {
    display: block;
    width: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>
