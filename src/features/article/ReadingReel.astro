---
/**
 * 目次の下に置く、読んだぶんだけ積まれる立方体（reel.ts）。進み具合は
 * 上端の進捗バーが支援技術に伝えているので、こちらは絵として隠す。
 */
---

<div class="reading-reel" data-reading-reel aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import { mountReel } from './reel';

  for (const el of document.querySelectorAll<HTMLElement>('[data-reading-reel]')) mountReel(el);
</script>

<style>
  /* 目次の列は中でスクロールする。その底に貼り付けて、目次が長くても
     立方体はいつも見えているようにする。 */
  .reading-reel {
    position: sticky;
    bottom: 0;
    margin-top: 1rem;
    padding-block: 2rem 0.5rem;
    /* 下から上がってくる目次の行は、紙に溶けてから立方体の下へ消える。
       箱で隠すと、そこだけ紙を切り貼りしたように見える。 */
    background: linear-gradient(to bottom, transparent, var(--bg) 1.75rem);
  }

  .reading-reel canvas {
    display: block;
    width: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>
