---
import { formatCompactReadingTime } from '../../i18n/site-copy';

/**
 * 本文の終わり。映画の終わりの FIN と、この記事の台帳番号と体積、
 * 前後の記事への「リール」。前後は公開日の順（古い側が前）。
 */
interface Reel {
  href: string;
  title: string;
  number: number;
}

interface Props {
  number: number;
  readingTime: number;
  lang?: 'en' | 'ja';
  previous?: Reel | undefined;
  next?: Reel | undefined;
}

const { number, readingTime, lang = 'en', previous, next } = Astro.props;
const no = (n: number) => `No. ${String(n).padStart(3, '0')}`;
const root = Math.cbrt(Math.max(readingTime, 1)).toFixed(2);
---

<footer class="end-of-reel" data-pagefind-ignore>
  <p class="eor-fin" aria-hidden="true">— FIN —</p>
  <p class="eor-meta">
    <span>End of reel {no(number)}</span>
    <span aria-hidden="true">·</span>
    <span>{formatCompactReadingTime(readingTime, lang)} = {root}<sup>3</sup></span>
  </p>
  {
    (previous || next) && (
      <nav class="eor-reels" aria-label="Other reels">
        {previous ? (
          <a class="eor-reel eor-prev" href={previous.href} rel="prev">
            <span class="eor-dir">← previous reel · {no(previous.number)}</span>
            <span class="eor-title">{previous.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="eor-reel eor-next" href={next.href} rel="next">
            <span class="eor-dir">next reel · {no(next.number)} →</span>
            <span class="eor-title">{next.title}</span>
          </a>
        )}
      </nav>
    )
  }
</footer>

<style>
  .end-of-reel {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 0.0625rem solid var(--rule);
    text-align: center;
  }

  .eor-fin {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    letter-spacing: 0.2em;
    color: var(--ink);
  }

  .eor-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    letter-spacing: 0.08em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .eor-meta sup {
    font-size: 0.75em;
    line-height: 0;
  }

  .eor-reels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
    text-align: left;
  }

  .eor-reel {
    display: grid;
    gap: 0.25rem;
    min-height: 2.75rem;
    padding: 1rem 0;
    border-top: 0.0625rem solid var(--ink);
    color: var(--ink);
  }

  .eor-next {
    grid-column: 2;
    text-align: right;
  }

  .eor-dir {
    font-family: var(--font-mono);
    font-size: var(--font-ui-xs);
    letter-spacing: 0.08em;
    color: var(--amber-text);
  }

  .eor-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  @media (hover: hover) {
    .eor-reel:hover .eor-title {
      color: var(--amber-text);
    }
  }

  @media (max-width: 40rem) {
    .eor-reels {
      grid-template-columns: 1fr;
    }

    .eor-next {
      grid-column: 1;
    }
  }
</style>
