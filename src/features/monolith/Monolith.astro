---
/**
 * About の石。『2001 年宇宙の旅』のモノリスと同じ 1 : 4 : 9 の板を、
 * 1 ビットの網点で立てる。カメラが回って見上げ、触れると太陽が上の縁から
 * 昇る。描画は stage.ts、振付は choreo.ts、音は chord.ts。
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={['monolith', className]} data-monolith>
  <canvas class="monolith-canvas" aria-hidden="true"></canvas>
  <button type="button" class="monolith-touch">
    <span class="monolith-sr"
      >A black monolith in the proportions 1 : 4 : 9, standing on a dotted floor. Touch it.</span
    >
  </button>
</figure>

<script>
  import { mountMonolith } from './stage';

  for (const el of document.querySelectorAll<HTMLElement>('[data-monolith]')) mountMonolith(el);
</script>

<style>
  .monolith {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    line-height: 0;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .monolith-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .monolith-touch {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .monolith-touch:focus-visible {
    outline: 2px solid var(--amber-text);
    outline-offset: 4px;
  }

  .monolith-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
